<!-- =====================================================
     SUPABASE
===================================================== -->

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<script>

/* =========================================================
   SUPABASE
========================================================= */

const SUPABASE_URL =
    "https://pdwgyknthvnzqwpgblxt.supabase.co";

const SUPABASE_PUBLISHABLE_KEY =
    "sb_publishable_hFVf6lJFSekm7iIf2rdHmQ_PXw_DszE";

const supabaseClient =
    window.supabase.createClient(
        SUPABASE_URL,
        SUPABASE_PUBLISHABLE_KEY
    );


/* =========================================================
   FALLBACK BOOK DATA
========================================================= */

const fallbackBooks = {

    villainess:{
        id:"villainess",
        title:"Reincarnated as a Side Character: The Villainess is Obsessed with Me",
        status:"Ongoing",
        category:"ongoing",
        description:"Oliver Rothyl never expected his second life to place him directly in the path of a dangerous villainess. As secrets surrounding House Rothyl begin to surface, the line between survival and obsession becomes increasingly blurred.",
        chapters:"47 Chapters",
        crystals:"💎 18,420",
        readers:"1,284 Readers",
        tags:["Fantasy","Romance","Action","Reincarnation"],
        image:"https://images.unsplash.com/photo-1518709268805-4e9042af9f23?auto=format&fit=crop&w=1200&q=85",
        platforms:[
            {name:"Webnovel",url:"#"},
            {name:"Royal Road",url:"#"}
        ],
        featured:true,
        trending:true
    },

    beast:{
        id:"beast",
        title:"Beast Taming Online",
        status:"Ongoing",
        category:"ongoing",
        description:"An ancient world of portals, mana and beasts. Cloud awakens an unrecorded Beast Taming system and discovers three SSS-ranked dragons waiting for him.",
        chapters:"120 Chapters",
        crystals:"💎 15,720",
        readers:"1,017 Readers",
        tags:["Fantasy","System","Adventure","Beast Taming"],
        image:"https://images.unsplash.com/photo-1518709779341-56cf4537e94d?auto=format&fit=crop&w=1200&q=85",
        platforms:[
            {name:"Webnovel",url:"#"}
        ],
        trending:true
    },

    crownless:{
        id:"crownless",
        title:"Crownless Emperor of Darkness",
        status:"Development",
        category:"development",
        description:"Fen stands at the centre of a world where ancient beings, Great Witches, Faes, Wizards and Blessed clash for power.",
        chapters:"Coming Soon",
        crystals:"💎 9,800",
        readers:"642 Readers",
        tags:["Dark Fantasy","Supernatural","Magic"],
        image:"https://images.unsplash.com/photo-1519608487953-e999c86e7455?auto=format&fit=crop&w=1200&q=85",
        platforms:[
            {name:"Coming Soon",url:"#"}
        ]
    },

    magical:{
        id:"magical",
        title:"Magical Reincarnation",
        status:"Pre-release",
        category:"pre-release",
        description:"Ian begins a new life at Hope Orphanage, unaware that the world around him hides a much larger magical reality.",
        chapters:"Pre-release",
        crystals:"💎 4,280",
        readers:"311 Readers",
        tags:["Magic","Reincarnation","Fantasy"],
        image:"https://images.unsplash.com/photo-1534447677768-be436bb09401?auto=format&fit=crop&w=1200&q=85",
        platforms:[
            {name:"Coming Soon",url:"#"}
        ]
    }

};

let books = {...fallbackBooks};
let characters = [];
let currentUser = null;
let currentProfile = null;
let isAdmin = false;
let authMode = "login";
let currentFilter = "all";


/* =========================================================
   READER PROFILE SETTINGS
========================================================= */

let selectedTheme = "default";

function getInitials(name){
    const value = String(name || "Reader").trim();
    return value ? value.charAt(0).toUpperCase() : "R";
}

function applyTheme(theme, accent){
    const root = document.documentElement;
    const safeAccent = /^#[0-9a-fA-F]{6}$/.test(accent || "") ? accent : "#8b5cf6";
    root.style.setProperty("--purple", safeAccent);

    if(theme === "midnight"){
        root.style.setProperty("--bg", "#04060b");
        root.style.setProperty("--bg2", "#080c14");
        root.style.setProperty("--violet", safeAccent);
        root.style.setProperty("--pink", "#4f8cff");
    }else if(theme === "rose"){
        root.style.setProperty("--bg", "#0b070a");
        root.style.setProperty("--bg2", "#140b11");
        root.style.setProperty("--violet", safeAccent);
        root.style.setProperty("--pink", "#f06aa9");
    }else{
        root.style.setProperty("--bg", "#07070b");
        root.style.setProperty("--bg2", "#0d0d14");
        root.style.setProperty("--violet", "#b26cff");
        root.style.setProperty("--pink", "#ec4899");
    }

    selectedTheme = theme || "default";
    document.querySelectorAll("[data-theme-option]").forEach(function(item){
        item.classList.toggle("active", item.dataset.themeOption === selectedTheme);
    });
}

function previewAccent(value){
    if(!/^#[0-9a-fA-F]{6}$/.test(value || "")) return;
    document.getElementById("settingsAccentText").value = value;
    applyTheme(selectedTheme, value);
}

function syncAccentText(value){
    const normal = String(value || "").trim();
    if(/^#[0-9a-fA-F]{6}$/.test(normal)){
        document.getElementById("settingsAccentColor").value = normal;
        applyTheme(selectedTheme, normal);
    }
}

function resetAccent(){
    document.getElementById("settingsAccentColor").value = "#8b5cf6";
    document.getElementById("settingsAccentText").value = "#8b5cf6";
    applyTheme(selectedTheme, "#8b5cf6");
}

function selectTheme(theme, button){
    selectedTheme = theme;
    document.getElementById("settingsTheme").value = theme;
    document.querySelectorAll("[data-theme-option]").forEach(function(item){
        item.classList.toggle("active", item === button);
    });
    applyTheme(theme, document.getElementById("settingsAccentText").value);
}

function renderSettingsAvatar(){
    const img = document.getElementById("settingsAvatar");
    const fallback = document.getElementById("settingsAvatarFallback");
    const url = currentProfile?.avatar_url;
    const name = currentProfile?.display_name || currentProfile?.username || currentUser?.email || "Reader";

    if(url){
        img.src = url;
        img.style.display = "block";
        fallback.style.display = "none";
    }else{
        img.removeAttribute("src");
        img.style.display = "none";
        fallback.style.display = "grid";
        fallback.textContent = getInitials(name);
    }
}

async function loadProfileSettings(){
    if(!currentUser){
        showToast("Please sign in first.");
        return;
    }

    if(!currentProfile){
        await refreshUser();
    }

    if(!currentProfile){
        showToast("Your profile could not be loaded.");
        return;
    }

    document.getElementById("settingsUsername").value = currentProfile.username || "";
    document.getElementById("settingsDisplayName").value = currentProfile.display_name || "";
    document.getElementById("settingsBio").value = currentProfile.bio || "";

    const accent = /^#[0-9a-fA-F]{6}$/.test(currentProfile.accent_color || "") ? currentProfile.accent_color : "#8b5cf6";
    document.getElementById("settingsAccentColor").value = accent;
    document.getElementById("settingsAccentText").value = accent;

    selectedTheme = currentProfile.theme || "default";
    document.getElementById("settingsTheme").value = selectedTheme;
    applyTheme(selectedTheme, accent);
    renderSettingsAvatar();

    document.getElementById("avatarStatus").textContent = currentProfile.avatar_url ? "Profile avatar is active." : "No avatar uploaded yet.";
}

async function saveProfileSettings(){
    if(!currentUser){
        showToast("Please sign in first.");
        return;
    }

    const username = document.getElementById("settingsUsername").value.trim();
    const displayName = document.getElementById("settingsDisplayName").value.trim();
    const bio = document.getElementById("settingsBio").value.trim();
    const accent = document.getElementById("settingsAccentText").value.trim();
    const theme = document.getElementById("settingsTheme").value || selectedTheme || "default";

    if(!username){
        showToast("Username cannot be empty.");
        return;
    }
    if(!/^#[0-9a-fA-F]{6}$/.test(accent)){
        showToast("Accent colour must be a valid hex colour.");
        return;
    }

    const button = document.querySelector("#page-settings .btn.primary");
    const original = button.textContent;
    button.disabled = true;
    button.textContent = "Saving...";

    try{
        const {data,error} = await supabaseClient
            .from("profiles")
            .update({
                username: username,
                display_name: displayName || username,
                bio: bio,
                theme: theme,
                accent_color: accent
            })
            .eq("id", currentUser.id)
            .select("*")
            .single();

        if(error) throw error;

        currentProfile = data;
        selectedTheme = theme;
        applyTheme(theme, accent);
        updateProfileButton();
        renderSettingsAvatar();
        showToast("Profile settings saved.");
    }catch(error){
        console.error("Profile settings error:", error);
        showToast(error.message || "Could not save profile settings.");
    }finally{
        button.disabled = false;
        button.textContent = original;
    }
}

async function handleAvatarUpload(event){
    const file = event.target.files?.[0];
    event.target.value = "";

    if(!file || !currentUser) return;

    if(file.size > 5 * 1024 * 1024){
        showToast("Avatar must be 5 MB or smaller.");
        return;
    }

    const allowed = ["image/jpeg","image/png","image/webp","image/gif"];
    if(!allowed.includes(file.type)){
        showToast("Please choose a JPG, PNG, WEBP or GIF image.");
        return;
    }

    const status = document.getElementById("avatarStatus");
    status.textContent = "Uploading avatar...";

    try{
        const extMap = {
            "image/jpeg":"jpg",
            "image/png":"png",
            "image/webp":"webp",
            "image/gif":"gif"
        };
        const ext = extMap[file.type] || "jpg";
        const path = `${currentUser.id}/avatar.${ext}`;

        const {error: uploadError} = await supabaseClient.storage
            .from("avatars")
            .upload(path, file, {
                cacheControl: "3600",
                upsert: true,
                contentType: file.type
            });

        if(uploadError) throw uploadError;

        const {data: publicData} = supabaseClient.storage
            .from("avatars")
            .getPublicUrl(path);

        const avatarUrl = `${publicData.publicUrl}?v=${Date.now()}`;

        const {data: profile,error: profileError} = await supabaseClient
            .from("profiles")
            .update({avatar_url: avatarUrl})
            .eq("id", currentUser.id)
            .select("*")
            .single();

        if(profileError) throw profileError;

        currentProfile = profile;
        renderSettingsAvatar();
        updateProfileButton();
        status.textContent = "Avatar uploaded successfully.";
        showToast("Avatar updated.");
    }catch(error){
        console.error("Avatar upload error:", error);
        status.textContent = "Avatar upload failed.";
        showToast(error.message || "Could not upload avatar.");
    }
}

/* =========================================================
   READER PROFILE
========================================================= */

function openProfile(){
    if(!currentUser) return openAuth();
    const name=currentProfile?.display_name || currentProfile?.username || currentUser.email?.split("@")[0] || "Reader";
    const avatar=currentProfile?.avatar_url || "";
    document.getElementById("profileName").textContent=name;
    document.getElementById("profileEmail").textContent=currentUser.email || "";
    document.getElementById("profileCrystals").textContent=Number(currentProfile?.crystals || 0).toLocaleString()+" 💎";
    const img=document.getElementById("profileAvatar");
    const fallback=document.getElementById("profileAvatarFallback");
    if(avatar){img.src=avatar;img.style.display="block";fallback.style.display="none";}else{img.style.display="none";fallback.style.display="grid";fallback.textContent=name.charAt(0).toUpperCase();}
    loadCrystalRules();
    document.getElementById("profileModal").classList.add("active");
    document.body.style.overflow="hidden";
}

function closeProfile(){
    document.getElementById("profileModal").classList.remove("active");
    document.body.style.overflow="";
}

async function loadCrystalRules(){
    const text=document.getElementById("profileCrystalRules");
    const modalText=document.getElementById("modalCrystalRules");
    const supportText=document.getElementById("supportRulesText");
    try{
        const {data,error}=await supabaseClient.from("support_settings").select("chapters_required,crystals_reward,enabled").limit(1).maybeSingle();
        if(error) throw error;
        const rules=data || {chapters_required:10,crystals_reward:10,enabled:true};
        const message=rules.enabled
            ? `Read ${Number(rules.chapters_required || 10)} chapters to qualify for a ${Number(rules.crystals_reward || 10)}-crystal reward. Crystal rewards and support are subject to the current site rules.`
            : "Crystal rewards are currently disabled by the administrator.";
        if(text) text.textContent=message;
        if(modalText) modalText.textContent=message;
        if(supportText) supportText.textContent=message;
    }catch(error){
        const message="Crystal rules are currently unavailable. Please check back later.";
        if(text) text.textContent=message;if(modalText) modalText.textContent=message;if(supportText) supportText.textContent=message;
    }
}

async function refreshCrystalBalance(){
    if(!currentUser) return;
    const {data}=await supabaseClient.from("profiles").select("crystals,display_name,username,avatar_url").eq("id",currentUser.id).maybeSingle();
    if(data){currentProfile={...(currentProfile||{}),...data};}
    const balance=Number(currentProfile?.crystals || 0);
    const library=document.getElementById("userCrystals");
    if(library) library.textContent="Your profile crystals: "+balance.toLocaleString();
    const modal=document.getElementById("modalSupportBalance");
    if(modal) modal.textContent="Available: "+balance.toLocaleString()+" 💎";
    const profile=document.getElementById("profileCrystals");
    if(profile) profile.textContent=balance.toLocaleString()+" 💎";
}

/* =========================================================
   SEARCH
========================================================= */


/* =========================================================
   TOAST
========================================================= */

function showToast(message){

    const toast =
        document.getElementById("toast");

    toast.textContent = message;

    toast.classList.add("show");

    clearTimeout(window.toastTimer);

    window.toastTimer =
        setTimeout(function(){
            toast.classList.remove("show");
        },3500);
}


/* =========================================================
   NAVIGATION
========================================================= */

function navigate(page){

    document
        .querySelectorAll(".app-page")
        .forEach(function(item){
            item.classList.remove("active");
        });

    const target =
        document.getElementById("page-" + page);

    if(!target) return;

    target.classList.add("active");

    document
        .querySelectorAll(".nav-link")
        .forEach(function(link){

            link.classList.remove("active");

            if(link.dataset.page === page){
                link.classList.add("active");
            }

        });

    window.scrollTo({
        top:0,
        behavior:"smooth"
    });

    if(page !== "admin"){
        history.replaceState(null,"","#" + page);
    }

    if(page === "library"){
        loadLibrary();
    }

    if(page === "settings"){
        if(currentUser){
            loadProfileSettings();
        }else{
            showToast("Please sign in first.");
            navigate("home");
            openAuth();
            return;
        }
    }

    if(page === "admin"){
        if(isAdmin){
            loadAdminDashboard();
        }else{
            showToast("Administrator access required.");
            navigate("home");
        }
    }
}


/* =========================================================
   HASH
========================================================= */

function loadPageFromHash(){

    const hash =
        window.location.hash.replace("#","");

    const allowed = [
        "home",
        "books",
        "characters",
        "rankings",
        "support",
        "library"
    ];

    if(allowed.includes(hash)){
        navigate(hash);
    }else{
        navigate("home");
    }
}

window.addEventListener(
    "hashchange",
    loadPageFromHash
);


/* =========================================================
   DATABASE BOOK LOADING
========================================================= */

async function loadBooks(){
    try{
        const {data,error}=await supabaseClient.from("books").select("*").eq("published",true).order("created_at",{ascending:false});
        if(error) throw error;

        const rows=data || [];
        const liveBooks={};

        const supportResult=await supabaseClient.from("crystal_support").select("book_id,crystals");
        const supportTotals={};
        (supportResult.data||[]).forEach(row=>{supportTotals[row.book_id]=(supportTotals[row.book_id]||0)+Number(row.crystals||0);});

        const libraryResult=await supabaseClient.from("library").select("book_id");
        const libraryTotals={};
        (libraryResult.data||[]).forEach(row=>{libraryTotals[row.book_id]=(libraryTotals[row.book_id]||0)+1;});

        for(const book of rows){
            let tags=[];
            let platforms=[];
            let chapterCount=null;

            const genresResult=await supabaseClient.from("book_genres").select("genre_id,genres(name)").eq("book_id",book.id);
            if(!genresResult.error){
                tags=(genresResult.data||[]).map(item=>item.genres?.name).filter(Boolean);
            }

            const platformsResult=await supabaseClient.from("book_platforms").select("platform_name,platform_url").eq("book_id",book.id);
            if(!platformsResult.error){
                platforms=(platformsResult.data||[]).map(item=>({name:item.platform_name,url:item.platform_url}));
            }

            const chaptersResult=await supabaseClient.from("chapters").select("id",{count:"exact",head:true}).eq("book_id",book.id).eq("published",true);
            if(!chaptersResult.error) chapterCount=chaptersResult.count;

            liveBooks[book.id]={
                id:book.id,title:book.title,status:formatStatus(book.status),category:book.status,description:book.description||"",
                chapters:chapterCount!==null ? chapterCount+" Chapters" : "Chapters not added yet",
                crystals:"💎 "+(Number(book.default_crystals||0)+Number(supportTotals[book.id]||0)).toLocaleString(),
                readers:(Number(book.default_readers||0)+Number(libraryTotals[book.id]||0)).toLocaleString()+" Readers",
                tags:tags.length?tags:["Story"],image:book.cover_url||"",platforms,featured:!!book.featured,trending:!!book.trending,
                inLibrary:!!(currentUser && libraryTotals[book.id]),release_date:book.release_date||null,release_chapter_count:Number(book.release_chapter_count||0),
                countdown_title:book.countdown_title||"Release Countdown",countdown_message:book.countdown_message||"The next story begins soon.",
                pre_release_description:book.pre_release_description||"",countdown_enabled:!!book.countdown_enabled,
                show_countdown_homepage:book.show_countdown_homepage!==false,show_countdown_book_page:book.show_countdown_book_page!==false
            };
        }

        books=liveBooks; renderBooks(); updateFeature(); renderHomepageCountdown(); showConnection(true);
    }catch(error){
        console.error("Book loading error:",error); books={}; renderBooks(); updateFeature(); renderHomepageCountdown(); showConnection(false);
    }
}


/* =========================================================
   STATUS
========================================================= */

function formatStatus(status){

    if(!status) return "Unknown";

    return status
        .split("-")
        .map(function(word){
            return word.charAt(0).toUpperCase() + word.slice(1);
        })
        .join(" ");
}


/* =========================================================
   BOOK CARDS
========================================================= */

function createBookCard(id,book){
    const card=document.createElement("article");
    card.className="book-card";
    card.innerHTML=`
        <div class="book-cover" style="background-image:url('${escapeAttribute(book.image)}')">
            <span class="status">${escapeHTML(book.status)}</span>
        </div>
        <div class="book-info">
            <h3>${escapeHTML(book.title)}</h3>
            <p>${book.tags.slice(0,2).map(escapeHTML).join(" • ")}</p>
            <div class="book-meta"><span>${escapeHTML(book.readers)}</span><span class="crystals">${escapeHTML(book.crystals)}</span></div>
            <div class="book-card-actions">
                <button class="btn primary" type="button" data-book-action="open">View Story</button>
                <button class="btn" type="button" data-book-action="library">${book.inLibrary?"✓ In Library":"＋ Library"}</button>
            </div>
        </div>`;
    card.querySelector('[data-book-action="open"]').onclick=e=>{e.stopPropagation();openBook(id);};
    card.querySelector('[data-book-action="library"]').onclick=e=>{e.stopPropagation();toggleLibrary(id);};
    card.onclick=()=>openBook(id);
    return card;
}


function renderUpcoming(){
    const grid=document.getElementById("upcomingGrid");
    if(!grid) return;
    const entries=Object.entries(books).filter(([id,b])=>["pre-release","development","coming-soon","hiatus"].includes(b.category));
    if(!entries.length){grid.innerHTML='<div class="empty-state">No upcoming projects have been announced.</div>';return;}
    grid.innerHTML=entries.map(([id,b])=>`<div class="upcoming-card"><small class="eyebrow">${escapeHTML(b.status)}</small><h3>${escapeHTML(b.title)}</h3><p style="color:#92909d;max-width:450px;line-height:1.7;">${escapeHTML(b.pre_release_description||b.description||"More details coming soon.")}</p><button class="btn" type="button" onclick="openBook('${id}')">View Project</button></div>`).join("");
}


function renderBooks(){

    const homeGrid =
        document.getElementById("homeBooksGrid");

    const catalogueGrid =
        document.getElementById("catalogueGrid");

    if(!homeGrid || !catalogueGrid) return;

    homeGrid.innerHTML = "";
    catalogueGrid.innerHTML = "";

    const entries =
        Object.entries(books);

    const trending =
        entries.filter(function(item){
            return item[1].trending;
        });

    const homeItems =
        trending.length
            ? trending.slice(0,4)
            : entries.slice(0,4);

    if(!homeItems.length){

        homeGrid.innerHTML =
            '<div class="empty-state">No published stories yet.</div>';

    }else{

        homeItems.forEach(function([id,book]){
            homeGrid.appendChild(
                createBookCard(id,book)
            );
        });

    }

    renderCatalogue(currentFilter);
    renderSupportedRankings();
    renderUpcoming();
}


function renderCatalogue(category){

    const grid =
        document.getElementById("catalogueGrid");

    if(!grid) return;

    grid.innerHTML = "";

    let entries =
        Object.entries(books);

    if(category !== "all"){

        entries =
            entries.filter(function(item){
                return item[1].category === category;
            });

    }

    if(!entries.length){

        grid.innerHTML =
            '<div class="empty-state">No stories found in this category.</div>';

        return;
    }

    entries.forEach(function([id,book]){

        grid.appendChild(
            createBookCard(id,book)
        );

    });

}


function filterBooks(category,button){

    currentFilter = category;

    document
        .querySelectorAll(".filter-btn")
        .forEach(function(item){
            item.classList.remove("active");
        });

    button.classList.add("active");

    renderCatalogue(category);
}


/* =========================================================
   FEATURED BOOK
========================================================= */

function updateFeature(){
    const feature=document.getElementById("featureBook");
    const featureEntries=Object.entries(books).filter(item=>item[1].featured);
    const entry=featureEntries[0] || Object.entries(books)[0];
    if(!entry){
        if(feature) feature.style.display="none";
        return;
    }
    if(feature) feature.style.display="block";
    const [id,book]=entry;
    document.getElementById("featureTitle").textContent=book.title;
    document.getElementById("featureSubtitle").textContent=book.description ? book.description.substring(0,120)+"..." : "Featured Story";
    feature.style.backgroundImage="linear-gradient(145deg,rgba(139,92,246,.3),rgba(20,15,35,.9)),url('"+escapeAttribute(book.image)+"')";
    document.getElementById("featureButton").onclick=()=>openBook(id);
}


/* =========================================================
   BOOK MODAL
========================================================= */

function openBook(id){

    const book =
        books[id];

    if(!book) return;

    document.getElementById("modalTitle")
        .textContent = book.title;

    document.getElementById("modalStatus")
        .textContent = book.status;

    document.getElementById("modalDescription")
        .textContent = book.description;

    document.getElementById("modalChapters")
        .textContent = "📖 " + book.chapters;

    document.getElementById("modalCrystals")
        .textContent = book.crystals;

    document.getElementById("modalReaders")
        .textContent = "👥 " + book.readers;

    document.getElementById("modalImage")
        .style.backgroundImage =
        "url('" + book.image + "')";

    const tags =
        document.getElementById("modalTags");

    tags.innerHTML = "";

    book.tags.forEach(function(tag){

        const element =
            document.createElement("span");

        element.className = "tag";
        element.textContent = tag;

        tags.appendChild(element);

    });

    const platformList =
        document.getElementById("platformList");

    platformList.innerHTML = "";

    if(book.platforms && book.platforms.length){

        book.platforms.forEach(function(platform){

            const link =
                document.createElement("a");

            link.className = "platform";
            link.href = platform.url || "#";
            link.textContent = platform.name;

            if(platform.url && platform.url !== "#"){

                link.target = "_blank";
                link.rel = "noopener noreferrer";

            }

            platformList.appendChild(link);

        });

    }else{

        platformList.innerHTML =
            '<span style="color:#777;font-size:11px;">No platform links available yet.</span>';

    }

    activeBookIdForSupport = book.id;
    const libraryButton=document.getElementById("modalLibraryButton");
    if(libraryButton){libraryButton.textContent=book.inLibrary?"✓ In My Library":"＋ Add to My Library";libraryButton.onclick=()=>toggleLibrary(book.id);}
    const readButton=document.getElementById("modalReadButton");
    if(readButton){readButton.onclick=()=>startReading(book.id);}
    renderPublicCountdown(book);
    refreshCrystalBalance();

    document
        .getElementById("bookModal")
        .classList.add("active");

    document.body.style.overflow = "hidden";
}


let activeBookIdForSupport = null;
let countdownTimer = null;

function renderPublicCountdown(book){
    const box=document.getElementById("publicCountdown");
    if(!box) return;
    clearInterval(countdownTimer);
    if(!book.countdown_enabled || !book.show_countdown_book_page || !book.release_date){
        box.classList.remove("active");
        return;
    }
    box.classList.add("active");
    document.getElementById("publicCountdownTitle").textContent=book.countdown_title || "Release Countdown";
    document.getElementById("publicCountdownMessage").textContent=book.countdown_message || "The next story begins soon.";
    const update=()=>{
        const diff=new Date(book.release_date).getTime()-Date.now();
        if(diff<=0){
            document.getElementById("countdownFinished").style.display="block";
            document.getElementById("publicCountdownTimer").style.display="none";
            clearInterval(countdownTimer);
            return;
        }
        document.getElementById("countdownFinished").style.display="none";
        document.getElementById("publicCountdownTimer").style.display="flex";
        const total=Math.floor(diff/1000);
        document.getElementById("countdownDays").textContent=Math.floor(total/86400);
        document.getElementById("countdownHours").textContent=Math.floor((total%86400)/3600);
        document.getElementById("countdownMinutes").textContent=Math.floor((total%3600)/60);
        document.getElementById("countdownSeconds").textContent=total%60;
    };
    update();
    countdownTimer=setInterval(update,1000);
}

function renderHomepageCountdown(){
    const item=Object.values(books).find(book=>book.countdown_enabled && book.show_countdown_homepage && book.release_date);
    const countdown=document.getElementById("homeCountdown");
    if(!countdown) return;
    if(!item){countdown.style.display="flex";return;}
    clearInterval(window.homeCountdownTimer);
    const update=()=>{
        const diff=new Date(item.release_date).getTime()-Date.now();
        if(diff<=0){countdown.innerHTML='<div class="countdown-finished">The release is live.</div>';clearInterval(window.homeCountdownTimer);return;}
        const total=Math.floor(diff/1000);
        document.getElementById("homeCountdownDays").textContent=Math.floor(total/86400);
        document.getElementById("homeCountdownHours").textContent=Math.floor((total%86400)/3600);
        document.getElementById("homeCountdownMinutes").textContent=Math.floor((total%3600)/60);
    };
    update();window.homeCountdownTimer=setInterval(update,1000);
}

async function supportCurrentBook(){
    if(!currentUser){showToast("Sign in before supporting a story.");openAuth();return;}
    if(!activeBookIdForSupport){showToast("Open a story first.");return;}
    const amount=Number(document.getElementById("supportAmount").value);
    if(!Number.isInteger(amount) || amount<=0){showToast("Enter a valid crystal amount.");return;}
    try{
        const {data,error}=await supabaseClient.rpc("support_book",{p_book_id:activeBookIdForSupport,p_crystals:amount});
        if(error) throw error;
        if(data?.balance !== undefined && currentProfile) currentProfile.crystals=data.balance;
        document.getElementById("supportAmount").value="";
        await refreshCrystalBalance();
        await loadBooks();
        const book=books[activeBookIdForSupport];
        if(book) renderPublicCountdown(book);
        showToast("Story supported with "+amount.toLocaleString()+" crystals.");
    }catch(error){
        console.error(error);
        showToast(error.message || "Could not support this story.");
    }
}

function closeBook(){

    document
        .getElementById("bookModal")
        .classList.remove("active");

    document.body.style.overflow = "";
}


/* =========================================================
   AUTH
========================================================= */

function openAuth(){

    if(currentUser){
        navigate("settings");
        return;
    }

    document
        .getElementById("authModal")
        .classList.add("active");

    document.body.style.overflow = "hidden";
}

function closeAuth(){

    document
        .getElementById("authModal")
        .classList.remove("active");

    document.body.style.overflow = "";
}


function toggleAuthMode(){

    authMode =
        authMode === "login"
            ? "signup"
            : "login";

    const title =
        document.getElementById("authTitle");

    const subtitle =
        document.getElementById("authSubtitle");

    const username =
        document.getElementById("usernameField");

    const submit =
        document.getElementById("authSubmit");

    const modeButton =
        document.getElementById("authModeButton");

    if(authMode === "signup"){

        title.textContent =
            "Create Your Account";

        subtitle.textContent =
            "Join the BGDADDY Story Universe.";

        username.style.display =
            "block";

        submit.textContent =
            "Create Account";

        modeButton.textContent =
            "Already have an account";

    }else{

        title.textContent =
            "Welcome Back";

        subtitle.textContent =
            "Sign in to enter your reader space.";

        username.style.display =
            "none";

        submit.textContent =
            "Sign In";

        modeButton.textContent =
            "Create Account";

    }

}


async function submitAuth(){

    const email =
        document.getElementById("authEmail")
            .value.trim();

    const password =
        document.getElementById("authPassword")
            .value;

    const username =
        document.getElementById("authUsername")
            .value.trim();

    if(!email || !password){

        showToast("Enter your email and password.");

        return;
    }

    try{

        if(authMode === "login"){

            const {data,error} =
                await supabaseClient.auth.signInWithPassword({
                    email:email,
                    password:password
                });

            if(error) throw error;

            currentUser =
                data.user;

            await refreshUser();

            closeAuth();

            showToast("Welcome back.");

        }else{

            const {data,error} =
                await supabaseClient.auth.signUp({

                    email:email,

                    password:password,

                    options:{
                        emailRedirectTo:window.location.origin+window.location.pathname,
                        data:{
                            username:
                                username ||
                                email.split("@")[0],

                            display_name:
                                username ||
                                email.split("@")[0]
                        }
                    }

                });

            if(error) throw error;

            if(data.session){
                currentUser=data.user;
                await refreshUser();
                closeAuth();
                showToast("Account created. Welcome to the Story Universe.");
            }else{
                document.getElementById("authSubtitle").textContent="Account created. Check your email and click the confirmation link before signing in.";
                showToast("Account created. Check your email to confirm it.");
            }

        }

    }catch(error){

        console.error(error);

        showToast(
            error.message ||
            "Authentication failed."
        );

    }

}


async function resendConfirmation(){
    const email=document.getElementById("authEmail").value.trim();
    if(!email){showToast("Enter your email first.");return;}
    try{
        const {error}=await supabaseClient.auth.resend({type:"signup",email:email,options:{emailRedirectTo:window.location.origin+window.location.pathname}});
        if(error) throw error;
        const msg=document.getElementById("authMessage"); if(msg){msg.textContent="A new confirmation email has been sent.";msg.style.display="block";}
        showToast("Confirmation email sent.");
    }catch(error){showToast(error.message||"Could not resend confirmation email.");}
}


async function forgotPassword(){

    const email =
        document.getElementById("authEmail")
            .value.trim();

    if(!email){

        showToast(
            "Enter your email first."
        );

        return;
    }

    try{

        const {error} =
            await supabaseClient.auth
                .resetPasswordForEmail(email,{
                    redirectTo:
                        window.location.href
                });

        if(error) throw error;

        showToast(
            "Password reset email sent."
        );

    }catch(error){

        showToast(
            error.message ||
            "Could not send reset email."
        );

    }

}


async function signOut(){

    await supabaseClient.auth.signOut();

    currentUser = null;
    currentProfile = null;
    isAdmin = false;

    updateProfileButton();

    showToast("Signed out.");
}


/* =========================================================
   USER / PROFILE
========================================================= */

async function refreshUser(){

    const {
        data:{
            user
        }
    } =
        await supabaseClient.auth.getUser();

    currentUser =
        user || null;

    if(!currentUser){

        currentProfile = null;
        isAdmin = false;

        updateProfileButton();

        return;
    }

    const {data,error} =
        await supabaseClient
            .from("profiles")
            .select("*")
            .eq("id",currentUser.id)
            .maybeSingle();

    if(error){

        console.error(
            "Profile error:",
            error
        );

    }

    if(!data){
        const username=currentUser.user_metadata?.username || currentUser.email?.split("@")[0] || "reader";
        const {data:created,error:createdError}=await supabaseClient.from("profiles").insert({id:currentUser.id,username:username,display_name:currentUser.user_metadata?.display_name||username,role:"reader",crystals:0,bio:"",theme:"default",accent_color:"#8b5cf6"}).select("*").single();
        if(!createdError) data=created; else console.warn("Profile creation fallback:",createdError);
    }

    currentProfile=data||null;
    isAdmin=!!(currentProfile && currentProfile.role === "admin");

    updateProfileButton();

}


function updateProfileButton(){

    const button = document.getElementById("profileButton");
    const settingsNav = document.getElementById("settingsNav");
    const adminNav = document.getElementById("adminNav");

    if(!currentUser){
        button.textContent = "Sign In";
        button.onclick = openAuth;
        if(settingsNav) settingsNav.style.display = "none";
        if(adminNav) adminNav.style.display = "none";
        return;
    }

    const name =
        currentProfile?.display_name ||
        currentProfile?.username ||
        currentUser.email?.split("@")[0] ||
        "Account";

    button.textContent = name.substring(0,18);
    button.onclick = openAuth;

    if(settingsNav) settingsNav.style.display = "block";
    if(adminNav) adminNav.style.display = isAdmin ? "block" : "none";
}


/* =========================================================
   SEARCH
========================================================= */

function openSearch(){

    document
        .getElementById("searchModal")
        .classList.add("active");

    document.body.style.overflow = "hidden";

    setTimeout(function(){

        document
            .getElementById("searchInput")
            .focus();

    },100);

    performSearch();
}


function closeSearch(){

    document
        .getElementById("searchModal")
        .classList.remove("active");

    document.body.style.overflow = "";
}


function performSearch(){

    const query =
        document.getElementById("searchInput")
            .value
            .trim()
            .toLowerCase();

    const results =
        document.getElementById("searchResults");

    results.innerHTML = "";

    if(!query){

        results.innerHTML =
            '<div style="color:#777;font-size:12px;padding:10px;">Start typing to search.</div>';

        return;
    }

    let found = 0;

    Object.entries(books).forEach(function([id,book]){

        const haystack =
            (
                book.title +
                " " +
                book.description +
                " " +
                book.tags.join(" ")
            ).toLowerCase();

        if(haystack.includes(query)){

            found++;

            const result =
                document.createElement("button");

            result.className =
                "search-result";

            result.innerHTML =
                "<small>BOOK</small>" +
                escapeHTML(book.title);

            result.onclick =
                function(){

                    closeSearch();
                    openBook(id);

                };

            results.appendChild(result);

        }

    });

    characters.forEach(function(character){

        const haystack =
            (
                character.name +
                " " +
                (character.description || "")
            ).toLowerCase();

        if(haystack.includes(query)){

            found++;

            const result =
                document.createElement("button");

            result.className =
                "search-result";

            result.innerHTML =
                "<small>CHARACTER</small>" +
                escapeHTML(character.name);

            result.onclick =
                function(){

                    closeSearch();
                    navigate("characters");

                };

            results.appendChild(result);

        }

    });

    if(!found){

        results.innerHTML =
            '<div style="color:#777;font-size:12px;padding:10px;">No results found.</div>';

    }

}


/* =========================================================
   CHARACTERS
========================================================= */

async function loadCharacters(){
    try{
        const {data,error}=await supabaseClient.from("characters").select("*").order("created_at",{ascending:false});
        if(error) throw error;
        characters=data||[];
        renderCharacters();
    }catch(error){
        console.error("Character loading error:",error);
        characters=[];
        renderCharacters();
    }
}


function renderCharacters(){

    const grid =
        document.getElementById("charactersGrid");

    if(!grid) return;

    grid.innerHTML = "";

    if(!characters.length){

        grid.innerHTML =
            '<div class="empty-state">No characters have been added yet.</div>';

        return;
    }

    characters.forEach(function(character,index){

        const card =
            document.createElement("div");

        card.className =
            "character";

        card.style.backgroundImage =
            "url('" +
            escapeAttribute(
                character.image_url ||
                fallbackBooks.villainess.image
            ) +
            "')";

        card.innerHTML = `

            <div class="character-rank">
                ${escapeHTML(character.power_rank || "#" + (index + 1))}
            </div>

            <div class="character-info">

                <small>
                    ${escapeHTML(character.book || "STORY UNIVERSE")}
                </small>

                <h3>
                    ${escapeHTML(character.name)}
                </h3>

            </div>
        `;

        grid.appendChild(card);

    });

}


/* =========================================================
   RANKINGS
========================================================= */

function renderSupportedRankings(){

    const container =
        document.getElementById("supportedRankings");

    if(!container) return;

    const entries =
        Object.entries(books)
            .sort(function(a,b){

                const aValue =
                    parseInt(
                        String(a[1].crystals)
                            .replace(/[^\d]/g,"")
                    ) || 0;

                const bValue =
                    parseInt(
                        String(b[1].crystals)
                            .replace(/[^\d]/g,"")
                    ) || 0;

                return bValue - aValue;

            })
            .slice(0,4);

    container.innerHTML = "";

    entries.forEach(function([id,book],index){

        const row =
            document.createElement("div");

        row.className =
            "rank-row";

        row.innerHTML = `

            <div class="rank-number">
                ${String(index + 1).padStart(2,"0")}
            </div>

            <div class="avatar">
                ${escapeHTML(book.title.charAt(0))}
            </div>

            <div class="rank-name">

                <strong>
                    ${escapeHTML(
                        book.title.length > 25
                            ? book.title.substring(0,25) + "..."
                            : book.title
                    )}
                </strong>

                <span>
                    ${escapeHTML(book.tags.slice(0,2).join(" • "))}
                </span>

            </div>

            <div class="rank-value">
                ${escapeHTML(book.crystals)}
            </div>

        `;

        container.appendChild(row);

    });

}


/* =========================================================
   LIBRARY
========================================================= */

async function toggleLibrary(bookId){
    if(!currentUser){showToast("Sign in to add stories to your library.");openAuth();return;}
    const existing=await supabaseClient.from("library").select("id,following").eq("user_id",currentUser.id).eq("book_id",bookId).maybeSingle();
    if(existing.error){showToast(existing.error.message);return;}
    try{
        if(existing.data){
            const {error}=await supabaseClient.from("library").delete().eq("id",existing.data.id).eq("user_id",currentUser.id);
            if(error) throw error;
            showToast("Removed from your library.");
        }else{
            const {error}=await supabaseClient.from("library").upsert({user_id:currentUser.id,book_id:bookId,following:true,currently_reading:false,previously_read:false,progress:0},{onConflict:"user_id,book_id"});
            if(error) throw error;
            showToast("Added to your library.");
        }
        await loadBooks(); await loadLibrary();
    }catch(error){console.error(error);showToast(error.message||"Could not update your library.");}
}

async function startReading(bookId){
    if(!currentUser){showToast("Sign in to start reading and save your progress.");openAuth();return;}
    await openReader(bookId);
}

async function loadNotifications(){
    const panel=document.getElementById("notificationList"); const badge=document.getElementById("notificationBadge");
    if(!panel||!currentUser) return;
    const {data,error}=await supabaseClient.from("notifications").select("id,title,message,link,read,created_at").eq("user_id",currentUser.id).order("created_at",{ascending:false}).limit(30);
    if(error){panel.innerHTML='<div class="empty-state">Notifications are unavailable.</div>';return;}
    const unread=(data||[]).filter(x=>!x.read).length; badge.textContent=unread?String(unread):""; badge.style.display=unread?"grid":"none";
    panel.innerHTML=(data||[]).length?(data||[]).map(n=>`<button class="notification-item ${n.read?'':'unread'}" onclick="openNotification('${n.id}','${encodeURIComponent(n.link||'')}')"><strong>${escapeHTML(n.title)}</strong><span>${escapeHTML(n.message)}</span><small>${new Date(n.created_at).toLocaleString()}</small></button>`).join(""):'<div class="empty-state">No notifications yet.</div>';
}

async function openNotification(id,encodedLink){
    await supabaseClient.from("notifications").update({read:true}).eq("id",id).eq("user_id",currentUser.id);
    const link=decodeURIComponent(encodedLink||""); if(link){window.location.href=link;} else {loadNotifications();}
}

function openNotifications(){if(!currentUser){showToast("Sign in to view notifications.");openAuth();return;} document.getElementById("notificationModal").classList.add("active");document.body.style.overflow="hidden";loadNotifications();}
function closeNotifications(){document.getElementById("notificationModal").classList.remove("active");document.body.style.overflow="";}


async function loadLibrary(){
    if(!currentUser){
        document.getElementById("libraryLoggedOut").style.display="grid";
        document.getElementById("libraryLoggedIn").style.display="none";
        return;
    }
    document.getElementById("libraryLoggedOut").style.display="none";
    document.getElementById("libraryLoggedIn").style.display="block";
    try{
        const {data,error}=await supabaseClient.from("library").select("*").eq("user_id",currentUser.id).order("updated_at",{ascending:false});
        if(error) throw error;
        const rows=data||[];
        document.getElementById("readingCount").textContent=rows.filter(r=>r.currently_reading).length+" stories";
        document.getElementById("followingCount").textContent=rows.filter(r=>r.following).length+" stories";
        await refreshCrystalBalance();
        const list=document.getElementById("libraryBookList");
        const entries=rows.map(r=>({row:r,book:books[r.book_id]})).filter(x=>x.book);
        if(!entries.length){list.innerHTML='<div class="empty-state">Your library is empty. Open a story and tap Add to My Library.</div>';return;}
        list.innerHTML=entries.map(({row,book})=>`<div class="admin-book"><div class="admin-book-info"><strong>${escapeHTML(book.title)}</strong><span>${row.currently_reading?'Currently Reading':row.following?'Following':'Saved'} · ${Number(row.progress||0)}% progress</span></div><div class="admin-actions"><button class="btn" type="button" onclick="startReading('${book.id}')">${row.currently_reading?'Continue':'Start Reading'}</button><button class="btn" type="button" onclick="toggleLibrary('${book.id}')">Remove</button></div></div>`).join("");
    }catch(error){
        console.error(error);
        document.getElementById("readingCount").textContent="Unavailable";
        document.getElementById("followingCount").textContent="Unavailable";
        const list=document.getElementById("libraryBookList"); if(list) list.innerHTML='<div class="empty-state">Could not load your library.</div>';
    }
}


/* =========================================================
   ADMIN V2
========================================================= */

function switchAdminTab(tab,button){

    document.querySelectorAll(".admin-section").forEach(function(section){
        section.classList.toggle(
            "active",
            section.dataset.adminSection === tab
        );
    });

    document.querySelectorAll(".admin-tab").forEach(function(item){
        item.classList.toggle(
            "active",
            item.dataset.adminTab === tab
        );
    });

    if(button){
        button.classList.add("active");
    }

    if(tab === "releases"){
        loadReleaseBooks();
        loadReleaseList();
    }

    if(tab === "site"){
        loadSiteSettings();
    }

    if(tab === "system"){
        loadAdminActivity();
    }
}

async function checkAdmin(){

    if(!currentUser){
        isAdmin=false;
        return false;
    }

    if(!currentProfile){
        await refreshUser();
    }

    return !!isAdmin;
}

async function loadAdminDashboard(){

    if(!await checkAdmin()){
        showToast("Administrator access required.");
        navigate("home");
        return;
    }

    await loadAdminStats();
    await loadAdminBooks();
    await populateChapterBooks();
    await loadReleaseBooks();
    await loadReleaseList();
    await loadSiteSettings();
    await loadAdminActivity();

    const identity=document.getElementById("adminIdentity");
    if(identity){
        identity.textContent =
            (currentProfile?.display_name || currentProfile?.username || "Administrator") +
            " · " + (currentUser?.email || "");
    }
}

async function loadAdminStats(){

    const queries = await Promise.all([
        supabaseClient.from("books").select("id,status,published"),
        supabaseClient.from("chapters").select("id"),
        supabaseClient.from("characters").select("id"),
        supabaseClient.from("reviews").select("id")
    ]);

    const booksData=queries[0].data || [];
    const set=(id,value)=>{
        const el=document.getElementById(id);
        if(el) el.textContent=value;
    };

    set("adminBookCount",booksData.length);
    set("adminPublishedCount",booksData.filter(b=>b.published).length);
    set("adminPreReleaseCount",booksData.filter(b=>b.status==="pre-release").length);
    set("adminChapterCount",(queries[1].data||[]).length);
    set("adminCharacterCount",(queries[2].data||[]).length);
    set("adminReviewCount",(queries[3].data||[]).length);
}

async function loadAdminBooks(){

    const container=document.getElementById("adminBookList");
    if(!container) return;

    container.innerHTML="Loading books...";

    const {data,error}=await supabaseClient
        .from("books")
        .select("*")
        .order("created_at",{ascending:false});

    if(error){
        container.innerHTML="Could not load books: "+escapeHTML(error.message);
        return;
    }

    if(!data?.length){
        container.innerHTML='<div class="empty-state">No books have been created yet.</div>';
        return;
    }

    container.innerHTML="";

    data.forEach(function(book){

        const item=document.createElement("div");
        item.className="admin-book";

        item.innerHTML=`
            <div class="admin-book-preview">
                <img src="${escapeAttribute(book.cover_url || "https://images.unsplash.com/photo-1518709268805-4e9042af9f23?auto=format&fit=crop&w=200&q=70")}" alt="">
                <div>
                    <strong>${escapeHTML(book.title)}</strong>
                    <span>${escapeHTML(formatStatus(book.status))} · ${book.published?"Published":"Hidden"}${book.countdown_enabled?" · Countdown":""}</span>
                </div>
            </div>
            <div class="admin-actions" style="margin:0;">
                <button class="btn" onclick="editBook('${book.id}')">Edit</button>
                <button class="btn" onclick="editBookRelease('${book.id}')">Release</button>
                <button class="btn" onclick="toggleBookPublished('${book.id}',${!book.published})">${book.published?"Unpublish":"Publish"}</button>
                <button class="btn" onclick="deleteBook('${book.id}')">Delete</button>
            </div>
        `;

        container.appendChild(item);
    });
}

async function uploadBookCover(file){
    if(!file) return;
    if(!await checkAdmin()) return;
    const status=document.getElementById("adminCoverStatus");
    status.textContent="Uploading cover...";
    const ext=(file.name.split(".").pop() || "jpg").toLowerCase();
    const path=(document.getElementById("adminBookId").value || crypto.randomUUID())+"/cover-"+Date.now()+"."+ext;
    const {error}=await supabaseClient.storage.from("book-covers").upload(path,file,{upsert:true,contentType:file.type});
    if(error){status.textContent="Upload failed: "+error.message;showToast(error.message);return;}
    const {data}=supabaseClient.storage.from("book-covers").getPublicUrl(path);
    document.getElementById("adminCover").value=data.publicUrl;
    status.textContent="Cover uploaded successfully.";
}

async function uploadCharacterImage(file){
    if(!file) return;
    if(!await checkAdmin()) return;
    const status=document.getElementById("characterImageStatus");
    status.textContent="Uploading image...";
    const ext=(file.name.split(".").pop() || "jpg").toLowerCase();
    const path=(document.getElementById("characterSlug").value.trim() || crypto.randomUUID())+"/character-"+Date.now()+"."+ext;
    const {error}=await supabaseClient.storage.from("character-images").upload(path,file,{upsert:true,contentType:file.type});
    if(error){status.textContent="Upload failed: "+error.message;showToast(error.message);return;}
    const {data}=supabaseClient.storage.from("character-images").getPublicUrl(path);
    document.getElementById("characterImage").value=data.publicUrl;
    status.textContent="Character image uploaded successfully.";
}

async function saveBook(){

    if(!await checkAdmin()) return;

    const id=document.getElementById("adminBookId").value;
    const title=document.getElementById("adminTitle").value.trim();
    const slug=document.getElementById("adminSlug").value.trim();

    if(!title || !slug){
        showToast("Title and slug are required.");
        return;
    }

    const payload={
        title,
        slug,
        description:document.getElementById("adminDescription").value.trim(),
        cover_url:document.getElementById("adminCover").value.trim() || null,
        status:document.getElementById("adminStatus").value,
        author:document.getElementById("adminAuthor").value.trim() || "BGDADDY",
        featured:document.getElementById("adminFeatured").checked,
        trending:document.getElementById("adminTrending").checked,
        published:document.getElementById("adminPublished").checked,
        default_crystals:Number(document.getElementById("adminCrystals").value)||0,
        default_votes:Number(document.getElementById("adminVotes").value)||0,
        default_readers:Number(document.getElementById("adminReaders").value)||0
    };

    const result=id
        ? await supabaseClient.from("books").update(payload).eq("id",id)
        : await supabaseClient.from("books").insert(payload);

    if(result.error){
        showToast(result.error.message);
        return;
    }

    await logAdmin("Updated book","book",id || null);
    showToast(id?"Book updated.":"Book created.");
    resetBookForm();
    await loadAdminDashboard();
    await loadBooks();
}

async function editBook(id){

    if(!await checkAdmin()) return;

    const {data,error}=await supabaseClient
        .from("books").select("*").eq("id",id).single();

    if(error){
        showToast(error.message);
        return;
    }

    const set=(id,value)=>{
        const el=document.getElementById(id);
        if(el) el.value=value ?? "";
    };

    set("adminBookId",data.id);
    set("adminTitle",data.title);
    set("adminSlug",data.slug);
    set("adminDescription",data.description);
    set("adminCover",data.cover_url);
    set("adminStatus",data.status || "ongoing");
    set("adminAuthor",data.author || "BGDADDY");
    set("adminCrystals",data.default_crystals || 0);
    set("adminVotes",data.default_votes || 0);
    set("adminReaders",data.default_readers || 0);

    document.getElementById("adminFeatured").checked=!!data.featured;
    document.getElementById("adminTrending").checked=!!data.trending;
    document.getElementById("adminPublished").checked=!!data.published;
    document.getElementById("bookFormTitle").textContent="Edit Book";

    switchAdminTab("books");
    document.getElementById("page-admin").scrollIntoView({behavior:"smooth"});
}

function resetBookForm(){

    const values={
        adminBookId:"",
        adminTitle:"",
        adminSlug:"",
        adminDescription:"",
        adminCover:"",
        adminStatus:"ongoing",
        adminAuthor:"BGDADDY",
        adminCrystals:0,
        adminVotes:0,
        adminReaders:0
    };

    Object.entries(values).forEach(([id,value])=>{
        const el=document.getElementById(id);
        if(el) el.value=value;
    });

    ["adminFeatured","adminTrending","adminPublished"].forEach(id=>{
        document.getElementById(id).checked=false;
    });

    document.getElementById("bookFormTitle").textContent="Add New Book";
}

async function toggleBookPublished(id,published){

    if(!await checkAdmin()) return;

    const {error}=await supabaseClient
        .from("books").update({published}).eq("id",id);

    if(error){
        showToast(error.message);
        return;
    }

    await logAdmin(published?"Published book":"Unpublished book","book",id);
    showToast(published?"Book published.":"Book unpublished.");
    await loadAdminDashboard();
    await loadBooks();
}

async function deleteBook(id){

    if(!await checkAdmin()) return;

    if(!confirm("Delete this book permanently?")) return;

    const {error}=await supabaseClient.from("books").delete().eq("id",id);

    if(error){
        showToast(error.message);
        return;
    }

    await logAdmin("Deleted book","book",id);
    showToast("Book deleted.");
    await loadAdminDashboard();
    await loadBooks();
}


/* =========================================================
   PRE-RELEASE
========================================================= */

async function loadReleaseBooks(){

    const select=document.getElementById("releaseBook");
    if(!select) return;

    const {data,error}=await supabaseClient
        .from("books")
        .select("id,title,status,release_date,countdown_enabled")
        .order("title");

    if(error) return;

    select.innerHTML='<option value="">Select a book</option>';

    (data||[]).forEach(book=>{
        const option=document.createElement("option");
        option.value=book.id;
        option.textContent=book.title;
        select.appendChild(option);
    });
}

async function loadReleaseSettings(id){

    if(!id) return;

    const {data,error}=await supabaseClient
        .from("books")
        .select("*")
        .eq("id",id)
        .single();

    if(error){
        showToast(error.message);
        return;
    }

    document.getElementById("releaseDate").value=
        data.release_date ? toLocalDateTime(data.release_date) : "";

    document.getElementById("releaseChapterCount").value=data.release_chapter_count || 0;
    document.getElementById("releaseTitle").value=data.countdown_title || "";
    document.getElementById("releaseMessage").value=data.countdown_message || "";
    document.getElementById("releaseDescription").value=data.pre_release_description || "";
    document.getElementById("releaseEnabled").checked=!!data.countdown_enabled;
    document.getElementById("releaseHome").checked=!!data.show_countdown_homepage;
    document.getElementById("releaseBookPage").checked=data.show_countdown_book_page !== false;
}

function toLocalDateTime(value){
    const date=new Date(value);
    const pad=n=>String(n).padStart(2,"0");
    return `${date.getFullYear()}-${pad(date.getMonth()+1)}-${pad(date.getDate())}T${pad(date.getHours())}:${pad(date.getMinutes())}`;
}

async function saveReleaseSettings(){

    if(!await checkAdmin()) return;

    const id=document.getElementById("releaseBook").value;
    if(!id){
        showToast("Select a book first.");
        return;
    }

    const local=document.getElementById("releaseDate").value;

    const payload={
        release_date:local ? new Date(local).toISOString() : null,
        release_chapter_count:Number(document.getElementById("releaseChapterCount").value)||0,
        countdown_title:document.getElementById("releaseTitle").value.trim() || null,
        countdown_message:document.getElementById("releaseMessage").value.trim() || null,
        pre_release_description:document.getElementById("releaseDescription").value.trim() || null,
        countdown_enabled:document.getElementById("releaseEnabled").checked,
        show_countdown_homepage:document.getElementById("releaseHome").checked,
        show_countdown_book_page:document.getElementById("releaseBookPage").checked
    };

    const {error}=await supabaseClient.from("books").update(payload).eq("id",id);

    if(error){
        showToast(error.message);
        return;
    }

    await logAdmin("Updated release settings","book",id);
    showToast("Release settings saved.");
    await loadReleaseList();
    await loadBooks();
}

function editBookRelease(id){

    switchAdminTab("releases");
    const select=document.getElementById("releaseBook");
    if(select){
        select.value=id;
        loadReleaseSettings(id);
    }
}

async function loadReleaseList(){

    const container=document.getElementById("releaseList");
    if(!container) return;

    const {data,error}=await supabaseClient
        .from("books")
        .select("id,title,status,release_date,countdown_enabled,show_countdown_homepage")
        .not("release_date","is",null)
        .order("release_date",{ascending:true});

    if(error){
        container.innerHTML="Could not load releases.";
        return;
    }

    if(!data?.length){
        container.innerHTML='<div class="empty-state">No scheduled releases yet.</div>';
        return;
    }

    container.innerHTML=data.map(book=>`
        <div class="admin-book">
            <div class="admin-book-info">
                <strong>${escapeHTML(book.title)}</strong>
                <span>${book.release_date ? new Date(book.release_date).toLocaleString() : "No date"} · ${book.countdown_enabled?"Countdown enabled":"Countdown disabled"}</span>
            </div>
            <button class="btn" onclick="editBookRelease('${book.id}')">Edit</button>
        </div>
    `).join("");
}


/* =========================================================
   CHAPTERS
========================================================= */

async function populateChapterBooks(){

    const select=document.getElementById("chapterBook");
    if(!select) return;

    const {data,error}=await supabaseClient
        .from("books").select("id,title").order("title");

    if(error) return;

    select.innerHTML='<option value="">Select a book</option>';

    (data||[]).forEach(book=>{
        const option=document.createElement("option");
        option.value=book.id;
        option.textContent=book.title;
        select.appendChild(option);
    });
}

async function saveChapter(){

    if(!await checkAdmin()) return;

    const bookId=document.getElementById("chapterBook").value;
    const number=Number(document.getElementById("chapterNumber").value);
    const title=document.getElementById("chapterTitle").value.trim();
    const content=document.getElementById("chapterContent").value;
    const published=document.getElementById("chapterPublished").checked;

    if(!bookId || !number || !title || !content){
        showToast("Complete all chapter fields.");
        return;
    }

    const {error}=await supabaseClient.from("chapters").insert({
        book_id:bookId,
        chapter_number:number,
        title,
        content,
        published,
        published_at:published ? new Date().toISOString() : null
    });

    if(error){
        showToast(error.message);
        return;
    }

    await logAdmin("Added chapter","chapter");
    document.getElementById("chapterNumber").value="";
    document.getElementById("chapterTitle").value="";
    document.getElementById("chapterContent").value="";
    showToast("Chapter saved.");
    await loadAdminStats();
    await loadBooks();
}


/* =========================================================
   CHARACTERS
========================================================= */

async function saveCharacter(){

    if(!await checkAdmin()) return;

    const name=document.getElementById("characterName").value.trim();
    const slug=document.getElementById("characterSlug").value.trim();

    if(!name || !slug){
        showToast("Character name and slug are required.");
        return;
    }

    const {error}=await supabaseClient.from("characters").insert({
        name,
        slug,
        description:document.getElementById("characterDescription").value.trim(),
        image_url:document.getElementById("characterImage").value.trim() || null,
        power_rank:document.getElementById("characterRank").value.trim() || null
    });

    if(error){
        showToast(error.message);
        return;
    }

    await logAdmin("Added character","character");
    ["characterName","characterSlug","characterDescription","characterImage","characterRank"].forEach(id=>{
        document.getElementById(id).value="";
    });

    showToast("Character added.");
    await loadCharacters();
    await loadAdminStats();
}


/* =========================================================
   SITE SETTINGS
========================================================= */

async function getSiteSetting(key,defaults={}){

    const {data,error}=await supabaseClient
        .from("site_settings")
        .select("setting_value")
        .eq("setting_key",key)
        .maybeSingle();

    if(error){
        console.error(error);
        return defaults;
    }

    return data?.setting_value || defaults;
}

async function loadSiteSettings(){

    if(!await checkAdmin()) return;

    const general=await getSiteSetting("general",{
        site_name:"BGDADDY | Story Universe",
        author_name:"BGDADDY",
        maintenance_mode:false
    });

    const home=await getSiteSetting("homepage",{
        hero_title:"THE AUTHOR UNIVERSE",
        hero_subtitle:"Enter the worlds I've created.",
        announcement_enabled:false,
        announcement_text:""
    });

    const social=await getSiteSetting("social",{});
    const nav=await getSiteSetting("navigation",{
        home:true,books:true,characters:true,rankings:true,support:true,library:true
    });

    const set=(id,value)=>{
        const el=document.getElementById(id);
        if(el) el.value=value ?? "";
    };
    const check=(id,value)=>{
        const el=document.getElementById(id);
        if(el) el.checked=!!value;
    };

    set("settingSiteName",general.site_name);
    set("settingAuthorName",general.author_name);
    check("settingMaintenance",general.maintenance_mode);

    set("settingHeroTitle",home.hero_title);
    set("settingHeroSubtitle",home.hero_subtitle);
    set("settingAnnouncement",home.announcement_text);
    check("settingAnnouncementEnabled",home.announcement_enabled);

    set("socialWebnovel",social.webnovel);
    set("socialRoyalRoad",social.royal_road);
    set("socialDiscord",social.discord);
    set("socialInstagram",social.instagram);
    set("socialTikTok",social.tiktok);
    set("socialYouTube",social.youtube);

    check("navHome",nav.home);
    check("navBooks",nav.books);
    check("navCharacters",nav.characters);
    check("navRankings",nav.rankings);
    check("navSupport",nav.support);
    check("navLibrary",nav.library);
}

async function saveSiteSetting(key,value){

    const {error}=await supabaseClient
        .from("site_settings")
        .upsert({
            setting_key:key,
            setting_value:value,
            updated_by:currentUser?.id || null
        },{onConflict:"setting_key"});

    if(error) throw error;
}

async function saveSiteSettings(){

    if(!await checkAdmin()) return;

    try{

        await saveSiteSetting("general",{
            site_name:document.getElementById("settingSiteName").value.trim(),
            author_name:document.getElementById("settingAuthorName").value.trim(),
            maintenance_mode:document.getElementById("settingMaintenance").checked
        });

        await saveSiteSetting("homepage",{
            hero_title:document.getElementById("settingHeroTitle").value.trim(),
            hero_subtitle:document.getElementById("settingHeroSubtitle").value.trim(),
            announcement_enabled:document.getElementById("settingAnnouncementEnabled").checked,
            announcement_text:document.getElementById("settingAnnouncement").value.trim()
        });

        await saveSiteSetting("social",{
            webnovel:document.getElementById("socialWebnovel").value.trim(),
            royal_road:document.getElementById("socialRoyalRoad").value.trim(),
            discord:document.getElementById("socialDiscord").value.trim(),
            instagram:document.getElementById("socialInstagram").value.trim(),
            tiktok:document.getElementById("socialTikTok").value.trim(),
            youtube:document.getElementById("socialYouTube").value.trim()
        });

        await saveSiteSetting("navigation",{
            home:document.getElementById("navHome").checked,
            books:document.getElementById("navBooks").checked,
            characters:document.getElementById("navCharacters").checked,
            rankings:document.getElementById("navRankings").checked,
            support:document.getElementById("navSupport").checked,
            library:document.getElementById("navLibrary").checked
        });

        await logAdmin("Updated public site settings","settings");
        showToast("Public site settings saved.");

    }catch(error){
        console.error(error);
        showToast(error.message || "Could not save settings.");
    }
}


/* =========================================================
   ACTIVITY
========================================================= */

async function logAdmin(action,targetType=null,targetId=null){

    if(!currentUser || !isAdmin) return;

    try{
        await supabaseClient.rpc("log_admin_activity",{
            p_action:action,
            p_target_type:targetType,
            p_target_id:targetId
        });
    }catch(error){
        console.warn("Activity log failed:",error);
    }
}

async function loadAdminActivity(){

    const container=document.getElementById("adminActivityList");
    if(!container || !currentUser) return;

    const {data,error}=await supabaseClient
        .from("admin_activity")
        .select("id,action,target_type,target_id,created_at")
        .order("created_at",{ascending:false})
        .limit(12);

    if(error){
        container.innerHTML='<div class="empty-state">Could not load activity.</div>';
        return;
    }

    if(!data?.length){
        container.innerHTML='<div class="empty-state">No activity recorded yet.</div>';
        return;
    }

    container.innerHTML=data.map(item=>`
        <div class="admin-book">
            <div class="admin-book-info">
                <strong>${escapeHTML(item.action)}</strong>
                <span>${escapeHTML(item.target_type || "system")} · ${new Date(item.created_at).toLocaleString()}</span>
            </div>
        </div>
    `).join("");
}

/* =========================================================
   CONNECTION STATUS
========================================================= */

function showConnection(online){

    const dot =
        document.getElementById("connectionDot");

    const text =
        document.getElementById("connectionText");

    if(online){

        dot.classList.add("online");
        dot.classList.remove("offline");

        text.textContent =
            "Supabase connected";

        const adminStatus=document.getElementById("adminConnectionStatus");
        if(adminStatus){
            adminStatus.textContent="Connected";
        }

    }else{

        dot.classList.remove("online");
        dot.classList.add("offline");

        text.textContent =
            "Supabase unavailable";

        const adminStatus=document.getElementById("adminConnectionStatus");
        if(adminStatus){
            adminStatus.textContent="Unavailable";
        }

    }

}


/* =========================================================
   REAL CONNECTION TEST
========================================================= */

async function testSupabaseConnection(){

    try{

        const {error} =
            await supabaseClient
                .from("books")
                .select("id")
                .limit(1);

        if(error){

            console.error(
                "Supabase connection error:",
                error
            );

            showConnection(false);

            return false;
        }

        showConnection(true);

        console.log(
            "BGDADDY Story Universe is connected to Supabase."
        );

        return true;

    }catch(error){

        console.error(error);

        showConnection(false);

        return false;

    }

}


/* =========================================================
   ESCAPE HTML
========================================================= */

function escapeHTML(value){

    return String(value ?? "")
        .replace(/&/g,"&amp;")
        .replace(/</g,"&lt;")
        .replace(/>/g,"&gt;")
        .replace(/"/g,"&quot;")
        .replace(/'/g,"&#039;");

}


function escapeAttribute(value){

    return String(value ?? "")
        .replace(/'/g,"%27")
        .replace(/"/g,"%22");

}


/* =========================================================
   MODAL OUTSIDE CLICK
========================================================= */

document
    .getElementById("bookModal")
    .addEventListener("click",function(event){

        if(event.target === this){
            closeBook();
        }

    });


document
    .getElementById("authModal")
    .addEventListener("click",function(event){

        if(event.target === this){
            closeAuth();
        }

    });


document
    .getElementById("profileModal")
    .addEventListener("click",function(event){
        if(event.target === this){
            closeProfile();
        }
    });


document
    .getElementById("searchModal")
    .addEventListener("click",function(event){

        if(event.target === this){
            closeSearch();
        }

    });


document.addEventListener(
    "keydown",
    function(event){

        if(event.key === "Escape"){

            closeBook();
            closeAuth();
            closeSearch();
            closeProfile();

        }

    }
);


/* =========================================================
   INTRO
========================================================= */

function skipIntro(){

    document
        .getElementById("intro")
        .classList.add("hidden");

    document
        .getElementById("app")
        .classList.add("ready");

    loadPageFromHash();

}


setTimeout(function(){
    skipIntro();
},5000);


/* =========================================================
   AUTH STATE
========================================================= */

supabaseClient.auth.onAuthStateChange(
    async function(event,session){

        currentUser =
            session?.user || null;

        if(currentUser){

            await refreshUser();
            if(currentProfile){
                applyTheme(currentProfile.theme || "default", currentProfile.accent_color || "#8b5cf6");
                loadNotifications();
            }

        }else{

            currentProfile = null;
            isAdmin = false;

            updateProfileButton();

        }

    }
);


/* =========================================================
   INITIALISE
========================================================= */

async function initialise(){

    renderBooks();

    await testSupabaseConnection();

    await refreshUser();
    if(currentUser) loadNotifications();

    if(currentProfile){
        applyTheme(currentProfile.theme || "default", currentProfile.accent_color || "#8b5cf6");
    }

    await loadBooks();

    await loadCharacters();
    await loadCrystalRules();

    loadPageFromHash();

}




/* =========================================================
   STORY READER LOGIC
========================================================= */

let readerBookId=null;
let readerChapters=[];
let readerChapterIndex=0;
let readerSettingsOpen=false;
let readerSpeechActive=false;
let readerSaveTimer=null;

function loadReaderSettings(){
    try{
        const saved=JSON.parse(localStorage.getItem("bgdaddy_reader_settings")||"{}");
        if(saved.fontSize) document.getElementById("readerFontSize").value=saved.fontSize;
        if(saved.lineHeight) document.getElementById("readerLineHeight").value=saved.lineHeight;
        if(saved.fontFamily) document.getElementById("readerFontFamily").value=saved.fontFamily;
    }catch(error){console.warn("Reader settings could not be loaded.",error);}
    applyReaderSettings(false);
}

function saveReaderSettings(){
    try{
        localStorage.setItem("bgdaddy_reader_settings",JSON.stringify({
            fontSize:document.getElementById("readerFontSize").value,
            lineHeight:document.getElementById("readerLineHeight").value,
            fontFamily:document.getElementById("readerFontFamily").value
        }));
    }catch(error){console.warn("Reader settings could not be saved.",error);}
}

function applyReaderSettings(save=true){
    const content=document.getElementById("readerContent");
    if(!content) return;
    const size=Number(document.getElementById("readerFontSize").value||18);
    const line=Number(document.getElementById("readerLineHeight").value||1.8);
    const family=document.getElementById("readerFontFamily").value;
    content.style.fontSize=size+"px";
    content.style.lineHeight=String(line);
    content.style.fontFamily=family==="serif"?"Georgia,serif":family==="sans"?"Arial,sans-serif":"system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif";
    if(save) saveReaderSettings();
}

function toggleReaderSettings(){
    readerSettingsOpen=!readerSettingsOpen;
    document.getElementById("readerSettings").classList.toggle("active",readerSettingsOpen);
}

async function getLibraryEntry(bookId){
    if(!currentUser) return null;
    const {data,error}=await supabaseClient.from("library").select("id,following,currently_reading,previously_read,progress").eq("user_id",currentUser.id).eq("book_id",bookId).maybeSingle();
    if(error){console.error(error);return null;}
    return data||null;
}

async function ensureReaderLibraryEntry(bookId){
    if(!currentUser) return null;
    const existing=await getLibraryEntry(bookId);
    if(existing){
        const {data,error}=await supabaseClient.from("library").update({currently_reading:true,previously_read:false,updated_at:new Date().toISOString()}).eq("id",existing.id).eq("user_id",currentUser.id).select("*").maybeSingle();
        if(error) throw error;
        return data||existing;
    }
    const {data,error}=await supabaseClient.from("library").insert({user_id:currentUser.id,book_id:bookId,following:false,currently_reading:true,previously_read:false,progress:0}).select("*").maybeSingle();
    if(error) throw error;
    return data||null;
}

async function getLastReaderChapter(bookId){
    if(!currentUser) return null;
    const {data,error}=await supabaseClient.from("reading_progress").select("chapter_id,progress,last_read_at").eq("user_id",currentUser.id).eq("book_id",bookId).order("last_read_at",{ascending:false}).limit(1).maybeSingle();
    if(error){console.warn("Reading progress could not be loaded.",error.message);return null;}
    return data||null;
}

async function openReader(bookId,chapterIndex=null){
    if(!currentUser){showToast("Sign in to start reading.");openAuth();return;}
    const book=books[bookId];
    if(!book){showToast("Story could not be found.");return;}

    try{
        const {data,error}=await supabaseClient.from("chapters").select("id,book_id,chapter_number,title,content,published,published_at").eq("book_id",bookId).eq("published",true).order("chapter_number",{ascending:true});
        if(error) throw error;
        readerChapters=data||[];
        if(!readerChapters.length){showToast("No published chapters are available yet.");return;}

        readerBookId=bookId;
        const last=chapterIndex===null?await getLastReaderChapter(bookId):null;
        let index=chapterIndex;
        if(index===null){
            index=last?.chapter_id?readerChapters.findIndex(ch=>ch.id===last.chapter_id):-1;
            if(index<0){
                const library=await getLibraryEntry(bookId);
                const progress=Number(library?.progress||0);
                index=progress>0?Math.min(readerChapters.length-1,Math.max(0,Math.round((progress/100)*(readerChapters.length-1)))):0;
            }
        }
        readerChapterIndex=Math.max(0,Math.min(readerChapters.length-1,Number(index)||0));

        await ensureReaderLibraryEntry(bookId);
        document.getElementById("readerBookTitle").textContent=book.title;
        document.getElementById("readerModal").classList.add("active");
        document.body.style.overflow="hidden";
        readerSettingsOpen=false;
        document.getElementById("readerSettings").classList.remove("active");
        loadReaderSettings();
        renderReaderChapter();
    }catch(error){
        console.error(error);
        showToast(error.message||"Could not open the reader.");
    }
}

function renderReaderChapter(){
    const chapter=readerChapters[readerChapterIndex];
    if(!chapter) return;

    stopReaderSpeech();
    document.getElementById("readerChapterTitle").textContent="Chapter "+chapter.chapter_number+(chapter.title?" · "+chapter.title:"");

    const content=document.getElementById("readerContent");
    const raw=String(chapter.content||"").replace(/\r\n/g,"\n").replace(/\r/g,"\n");
    const paragraphs=raw.split(/\\n\\s*\\n/).map(x=>x.trim()).filter(Boolean);
    content.innerHTML=paragraphs.length?paragraphs.map(p=>"<p>"+escapeHTML(p).replace(/\n/g,"<br>")+"</p>").join(""):"<div class=\"reader-empty\">This chapter has no readable content.</div>";
    applyReaderSettings(false);

    const wrap=document.getElementById("readerContentWrap");
    wrap.scrollTop=0;
    updateReaderProgress();
    updateReaderButtons();
    updateReaderChapterList();
    scheduleReaderProgressSave(0);
}

function updateReaderButtons(){
    document.getElementById("readerPrevious").disabled=readerChapterIndex<=0;
    document.getElementById("readerNext").disabled=readerChapterIndex>=readerChapters.length-1;
}

function updateReaderProgress(){
    const wrap=document.getElementById("readerContentWrap");
    if(!wrap) return;
    const max=wrap.scrollHeight-wrap.clientHeight;
    const percent=max>0?Math.min(100,Math.max(0,(wrap.scrollTop/max)*100)):100;
    document.getElementById("readerProgress").style.width=percent+"%";
    scheduleReaderProgressSave(percent);
}

function scheduleReaderProgressSave(percent){
    clearTimeout(readerSaveTimer);
    readerSaveTimer=setTimeout(()=>saveCurrentReadingProgress(percent),900);
}

async function saveCurrentReadingProgress(scrollPercent=0){
    if(!currentUser||!readerBookId||!readerChapters[readerChapterIndex]) return;
    const chapter=readerChapters[readerChapterIndex];
    try{
        const library=await getLibraryEntry(readerBookId);
        const overall=((readerChapterIndex+Math.min(1,Math.max(0,Number(scrollPercent)/100)))/readerChapters.length)*100;
        const overallProgress=Math.min(100,Math.round(overall));
        if(library){
            const completed=readerChapterIndex===readerChapters.length-1&&Number(scrollPercent)>=95;
            const {error}=await supabaseClient.from("library").update({currently_reading:!completed,previously_read:completed,progress:overallProgress,updated_at:new Date().toISOString()}).eq("id",library.id).eq("user_id",currentUser.id);
            if(error) console.warn("Library progress could not be saved.",error.message);
        }

        const {data:existing,error:findError}=await supabaseClient.from("reading_progress").select("id").eq("user_id",currentUser.id).eq("book_id",readerBookId).eq("chapter_id",chapter.id).maybeSingle();
        if(findError) throw findError;
        const payload={user_id:currentUser.id,book_id:readerBookId,chapter_id:chapter.id,progress:Number(Number(scrollPercent).toFixed(2)),last_read_at:new Date().toISOString()};
        if(existing){
            const {error}=await supabaseClient.from("reading_progress").update(payload).eq("id",existing.id).eq("user_id",currentUser.id);
            if(error) throw error;
        }else{
            const {error}=await supabaseClient.from("reading_progress").insert(payload);
            if(error) throw error;
        }
    }catch(error){console.warn("Reading progress could not be saved.",error.message||error);}
}

async function openNextChapter(){
    if(readerChapterIndex>=readerChapters.length-1) return;
    await saveCurrentReadingProgress(100);
    readerChapterIndex++;
    renderReaderChapter();
}

async function openPreviousChapter(){
    if(readerChapterIndex<=0) return;
    await saveCurrentReadingProgress(100);
    readerChapterIndex--;
    renderReaderChapter();
}

function openChapterList(){
    document.getElementById("chapterListBookTitle").textContent=books[readerBookId]?.title||"Chapters";
    document.getElementById("chapterListSubtitle").textContent=readerChapters.length+" published chapter"+(readerChapters.length===1?"":"s")+" available.";
    updateReaderChapterList();
    document.getElementById("chapterListModal").classList.add("active");
}

function updateReaderChapterList(){
    const list=document.getElementById("readerChapterList");
    if(!list) return;
    list.innerHTML=readerChapters.map((chapter,index)=>`<button class="reader-chapter-item ${index===readerChapterIndex?'active':''}" type="button" onclick="selectReaderChapter(${index})"><strong>Chapter ${chapter.chapter_number}</strong><span>${escapeHTML(chapter.title||"Untitled chapter")}</span></button>`).join("");
}

function selectReaderChapter(index){
    readerChapterIndex=Math.max(0,Math.min(readerChapters.length-1,Number(index)||0));
    document.getElementById("chapterListModal").classList.remove("active");
    renderReaderChapter();
}

function closeChapterList(){document.getElementById("chapterListModal").classList.remove("active");}

function toggleReaderSpeech(){
    if(readerSpeechActive){stopReaderSpeech();return;}
    if(!("speechSynthesis" in window)){showToast("Read aloud is not supported on this device.");return;}
    const chapter=readerChapters[readerChapterIndex];
    if(!chapter) return;
    const utterance=new SpeechSynthesisUtterance(String(chapter.content||""));
    utterance.rate=1;
    utterance.onend=()=>{readerSpeechActive=false;document.getElementById("readerSpeechButton").textContent="🔊";};
    utterance.onerror=()=>{readerSpeechActive=false;document.getElementById("readerSpeechButton").textContent="🔊";};
    window.speechSynthesis.cancel();
    window.speechSynthesis.speak(utterance);
    readerSpeechActive=true;
    document.getElementById("readerSpeechButton").textContent="⏹";
}

function stopReaderSpeech(){
    if("speechSynthesis" in window) window.speechSynthesis.cancel();
    readerSpeechActive=false;
    const button=document.getElementById("readerSpeechButton");
    if(button) button.textContent="🔊";
}

function closeReader(){
    clearTimeout(readerSaveTimer);
    saveCurrentReadingProgress(Number((document.getElementById("readerProgress")?.style.width||"0").replace("%",""))||0);
    stopReaderSpeech();
    closeChapterList();
    document.getElementById("readerModal").classList.remove("active");
    document.getElementById("readerSettings").classList.remove("active");
    readerSettingsOpen=false;
    document.body.style.overflow="";
    if(currentUser){loadLibrary();loadBooks();}
}

document.getElementById("chapterListModal").addEventListener("click",function(event){
    if(event.target===this) closeChapterList();
});

document.addEventListener("keydown",function(event){
    if(!document.getElementById("readerModal")?.classList.contains("active")) return;
    if(event.key==="Escape"){closeReader();return;}
    if(event.key==="ArrowRight"&&!event.target.matches("input,select,textarea")) openNextChapter();
    if(event.key==="ArrowLeft"&&!event.target.matches("input,select,textarea")) openPreviousChapter();
});


/* START */

initialise();

</script>

</body>
</html>
