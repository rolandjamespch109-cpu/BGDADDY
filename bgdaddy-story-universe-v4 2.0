<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#07070b">
<title>BGDADDY | Story Universe</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

:root{
    --bg:#07070b;
    --bg2:#0d0d14;
    --panel:rgba(255,255,255,.055);
    --panel2:rgba(255,255,255,.085);
    --text:#f7f4ff;
    --muted:#9693a7;
    --purple:#8b5cf6;
    --violet:#b26cff;
    --pink:#ec4899;
    --gold:#f4c95d;
    --cyan:#55d9ff;
    --border:rgba(255,255,255,.09);
    --green:#4ade80;
    --red:#fb7185;
}

html,body{
    width:100%;
    min-height:100%;
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
    background:
        radial-gradient(circle at 15% 10%,rgba(139,92,246,.12),transparent 28%),
        radial-gradient(circle at 90% 35%,rgba(236,72,153,.08),transparent 25%),
        var(--bg);
    color:var(--text);
    min-height:100vh;
    overflow-x:hidden;
}

button,input,textarea,select{
    font:inherit;
}

button{
    cursor:pointer;
}

/* =========================================================
   INTRO
========================================================= */

#intro{
    position:fixed;
    inset:0;
    z-index:9999;
    background:
        radial-gradient(circle at center,rgba(139,92,246,.12),transparent 35%),
        #030306;
    display:flex;
    align-items:center;
    justify-content:center;
    overflow:hidden;
    transition:opacity 1s ease,visibility 1s ease;
}

#intro.hidden{
    opacity:0;
    visibility:hidden;
    pointer-events:none;
}

.intro-title{
    position:absolute;
    z-index:5;
    text-align:center;
    opacity:0;
    animation:introText 2s ease forwards;
    animation-delay:.7s;
}

.intro-title .small{
    font-size:11px;
    letter-spacing:6px;
    color:var(--muted);
    text-transform:uppercase;
}

.intro-title h1{
    font-size:clamp(35px,8vw,85px);
    letter-spacing:12px;
    margin-top:10px;
    background:linear-gradient(90deg,#fff,#bba0ff,#fff);
    -webkit-background-clip:text;
    background-clip:text;
    color:transparent;
}

.intro-title p{
    margin-top:10px;
    color:#888394;
    letter-spacing:3px;
    font-size:11px;
    text-transform:uppercase;
}

@keyframes introText{
    from{opacity:0;transform:translateY(20px)}
    to{opacity:1;transform:translateY(0)}
}

.intro-stars{
    position:absolute;
    inset:0;
    background-image:
        radial-gradient(circle,rgba(255,255,255,.8) 1px,transparent 1.5px),
        radial-gradient(circle,rgba(255,255,255,.4) 1px,transparent 1.5px);
    background-size:90px 90px,150px 150px;
    animation:starsMove 18s linear infinite;
    opacity:.35;
}

.intro-stars::before,
.intro-stars::after{
    content:"";
    position:absolute;
    inset:0;
    background-image:
        radial-gradient(circle,rgba(255,255,255,.7) 1px,transparent 1.5px);
    background-size:120px 120px;
}

.intro-stars::before{
    transform:scale(1.4);
    animation:starsMove 28s linear infinite;
    opacity:.2;
}

.intro-stars::after{
    transform:scale(1.8);
    animation:starsMove 38s linear infinite;
    opacity:.15;
}

@keyframes starsMove{
    from{transform:translateY(0)}
    to{transform:translateY(90px)}
}

/* =========================================================
   DRAGON
========================================================= */

.dragon{
    position:absolute;
    width:min(850px,90vw);
    height:330px;
    left:50%;
    top:48%;
    transform:translate(-50%,-50%);
    z-index:3;
    animation:dragonFlight 4.8s cubic-bezier(.2,.7,.2,1) forwards;
}

.dragon-body{
    position:absolute;
    width:610px;
    height:85px;
    left:100px;
    top:120px;
    border-radius:50%;
    background:
        radial-gradient(circle at 35% 40%,#9b63e8,#3d226e 45%,#140d27 80%);
    box-shadow:
        0 0 35px rgba(145,85,255,.35),
        inset 0 0 30px rgba(0,0,0,.6);
    transform:rotate(-7deg);
}

.dragon-head{
    position:absolute;
    left:20px;
    top:87px;
    width:150px;
    height:120px;
    border-radius:65% 45% 55% 45%;
    background:linear-gradient(135deg,#a66bff,#482879 65%,#171022);
    box-shadow:0 0 35px rgba(165,95,255,.3);
    transform:rotate(-14deg);
}

.dragon-eye{
    position:absolute;
    width:13px;
    height:13px;
    border-radius:50%;
    background:#ffe99a;
    box-shadow:0 0 18px #ffd76b;
    right:32px;
    top:42px;
}

.dragon-horn{
    position:absolute;
    width:35px;
    height:65px;
    border-radius:100% 0 100% 0;
    border:5px solid #c8a6ff;
    border-left:0;
    border-bottom:0;
}

.horn1{
    left:28px;
    top:8px;
    transform:rotate(-25deg);
}

.horn2{
    left:60px;
    top:0;
    transform:rotate(-8deg);
}

.dragon-whisker{
    position:absolute;
    width:150px;
    height:45px;
    border-top:3px solid rgba(214,185,255,.75);
    border-radius:50%;
    left:-70px;
    top:55px;
    transform:rotate(12deg);
}

.wing{
    position:absolute;
    width:190px;
    height:125px;
    background:
        linear-gradient(145deg,rgba(159,104,255,.7),rgba(43,19,78,.8));
    clip-path:polygon(
        0 100%,20% 5%,42% 42%,70% 0,
        58% 65%,100% 32%,75% 100%
    );
    top:30px;
    opacity:.75;
}

.wing1{
    left:310px;
    transform:rotate(-12deg);
}

.wing2{
    left:430px;
    top:48px;
    transform:scaleX(-1) rotate(-5deg);
}

.dragon-tail{
    position:absolute;
    right:20px;
    top:135px;
    width:250px;
    height:50px;
    border-top:18px solid #5d3394;
    border-radius:50%;
    transform:rotate(-18deg);
}

.dragon-tail::after{
    content:"";
    position:absolute;
    right:-35px;
    top:-27px;
    border-left:50px solid #7951bd;
    border-top:25px solid transparent;
    border-bottom:25px solid transparent;
}

@keyframes dragonFlight{
    0%{
        transform:translate(-130vw,-20%) rotate(-12deg) scale(.65);
        opacity:0;
    }
    15%{opacity:1}
    48%{
        transform:translate(-50%,-50%) rotate(-4deg) scale(1);
    }
    72%{
        transform:translate(-45%,-55%) rotate(4deg) scale(1.04);
    }
    100%{
        transform:translate(130vw,-20%) rotate(12deg) scale(.7);
        opacity:0;
    }
}

.intro-skip{
    position:absolute;
    bottom:30px;
    right:30px;
    z-index:10;
    background:rgba(255,255,255,.06);
    border:1px solid rgba(255,255,255,.12);
    color:#aaa;
    padding:10px 16px;
    border-radius:100px;
}

/* =========================================================
   APP
========================================================= */

#app{
    min-height:100vh;
    opacity:0;
    visibility:hidden;
    transition:opacity .7s ease;
}

#app.ready{
    opacity:1;
    visibility:visible;
}

/* =========================================================
   NAV
========================================================= */

.nav{
    position:fixed;
    top:0;
    left:0;
    width:100%;
    z-index:1000;
    padding:18px 5%;
    display:flex;
    align-items:center;
    justify-content:space-between;
    background:rgba(7,7,11,.72);
    backdrop-filter:blur(20px);
    border-bottom:1px solid rgba(255,255,255,.06);
}

.logo{
    font-weight:800;
    letter-spacing:5px;
    font-size:18px;
    white-space:nowrap;
}

.logo span{
    color:var(--violet);
}

.nav-links{
    display:flex;
    gap:8px;
    align-items:center;
}

.nav-link{
    color:#aaa7b5;
    text-decoration:none;
    font-size:13px;
    padding:9px 12px;
    border-radius:9px;
    transition:.25s;
    border:0;
    background:transparent;
}

.nav-link:hover,
.nav-link.active{
    color:white;
    background:rgba(139,92,246,.12);
}

.nav-actions{
    display:flex;
    gap:10px;
    align-items:center;
}

.icon-btn,
.profile-btn{
    width:40px;
    height:40px;
    border-radius:50%;
    background:rgba(255,255,255,.06);
    border:1px solid var(--border);
    color:white;
}

.profile-btn{
    width:auto;
    border-radius:30px;
    padding:0 16px;
}

.connection-dot{
    width:8px;
    height:8px;
    border-radius:50%;
    background:#777;
    display:inline-block;
    margin-right:5px;
}

.connection-dot.online{
    background:var(--green);
    box-shadow:0 0 10px rgba(74,222,128,.7);
}

.connection-dot.offline{
    background:var(--red);
}

/* =========================================================
   PAGES
========================================================= */

.app-page{
    display:none;
    min-height:100vh;
    padding-top:76px;
}

.app-page.active{
    display:block;
    animation:pageEnter .45s ease;
}

@keyframes pageEnter{
    from{opacity:0;transform:translateY(15px)}
    to{opacity:1;transform:translateY(0)}
}

/* =========================================================
   HOME
========================================================= */

.hero{
    min-height:704px;
    padding:100px 6% 90px;
    display:grid;
    grid-template-columns:1.1fr .9fr;
    gap:50px;
    align-items:center;
    position:relative;
    overflow:hidden;
}

.hero::before{
    content:"";
    position:absolute;
    width:700px;
    height:700px;
    background:radial-gradient(circle,rgba(126,74,255,.16),transparent 65%);
    right:-150px;
    top:70px;
    pointer-events:none;
}

.eyebrow{
    color:#aa8bff;
    font-size:11px;
    letter-spacing:4px;
    text-transform:uppercase;
    margin-bottom:20px;
}

.hero h1{
    font-size:clamp(48px,7vw,90px);
    line-height:.96;
    letter-spacing:-4px;
    max-width:850px;
}

.hero h1 span{
    background:linear-gradient(90deg,#fff,#a77cff,#ec72ba);
    -webkit-background-clip:text;
    background-clip:text;
    color:transparent;
}

.hero p{
    color:var(--muted);
    line-height:1.8;
    max-width:600px;
    margin:25px 0 32px;
}

.hero-buttons{
    display:flex;
    gap:12px;
    flex-wrap:wrap;
}

.btn{
    padding:14px 22px;
    border-radius:12px;
    border:1px solid var(--border);
    background:rgba(255,255,255,.05);
    color:white;
    text-decoration:none;
    font-weight:600;
    font-size:13px;
    transition:.3s;
}

.btn:hover{
    transform:translateY(-3px);
    background:rgba(255,255,255,.1);
}

.btn.primary{
    background:linear-gradient(135deg,#8557ee,#b15bca);
    border:none;
    box-shadow:0 15px 40px rgba(139,92,246,.25);
}

.feature-book{
    height:500px;
    border-radius:28px;
    overflow:hidden;
    position:relative;
    background:
        linear-gradient(145deg,rgba(139,92,246,.3),rgba(20,15,35,.9)),
        url("https://images.unsplash.com/photo-1518709268805-4e9042af9f23?auto=format&fit=crop&w=900&q=80")
        center/cover;
    border:1px solid rgba(255,255,255,.1);
    box-shadow:0 40px 100px rgba(0,0,0,.55);
    transform:rotate(2deg);
    transition:.5s;
}

.feature-book:hover{
    transform:rotate(0) scale(1.025);
}

.feature-book::after{
    content:"";
    position:absolute;
    inset:0;
    background:linear-gradient(transparent 35%,rgba(0,0,0,.92));
}

.feature-info{
    position:absolute;
    z-index:2;
    bottom:28px;
    left:28px;
    right:28px;
}

.feature-info small{
    color:#c2a6ff;
    letter-spacing:2px;
}

.feature-info h2{
    margin:8px 0;
    font-size:30px;
}

.feature-info p{
    margin:0;
    font-size:12px;
}

/* =========================================================
   SECTIONS
========================================================= */

.page-section{
    padding:80px 6%;
}

.section-heading{
    display:flex;
    justify-content:space-between;
    align-items:end;
    margin-bottom:28px;
}

.section-heading h2{
    font-size:30px;
}

.section-heading p{
    color:var(--muted);
    font-size:12px;
    margin-top:7px;
}

/* =========================================================
   BOOKS
========================================================= */

.books-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:18px;
}

.book-card{
    background:var(--panel);
    border:1px solid var(--border);
    border-radius:18px;
    overflow:hidden;
    cursor:pointer;
    transition:.35s cubic-bezier(.2,.8,.2,1);
}

.book-card:hover{
    transform:translateY(-8px);
    background:var(--panel2);
    border-color:rgba(164,120,255,.35);
    box-shadow:0 25px 60px rgba(0,0,0,.35);
}

.book-cover{
    height:290px;
    background-size:cover;
    background-position:center;
    position:relative;
}

.book-cover::after{
    content:"";
    position:absolute;
    inset:0;
    background:linear-gradient(transparent 60%,rgba(0,0,0,.45));
}

.status{
    position:absolute;
    z-index:2;
    top:12px;
    left:12px;
    padding:6px 9px;
    border-radius:100px;
    background:rgba(0,0,0,.65);
    backdrop-filter:blur(10px);
    font-size:9px;
    text-transform:uppercase;
    letter-spacing:1px;
}

.book-info{
    padding:16px;
}

.book-info h3{
    font-size:16px;
    margin-bottom:7px;
}

.book-info p{
    font-size:11px;
    color:var(--muted);
    min-height:32px;
}

.book-meta{
    display:flex;
    justify-content:space-between;
    margin-top:14px;
    font-size:10px;
    color:#aaa;
}

.crystals{
    color:var(--gold);
}

.empty-state{
    padding:50px 20px;
    text-align:center;
    color:var(--muted);
    border:1px dashed var(--border);
    border-radius:18px;
    grid-column:1/-1;
}

/* =========================================================
   CATALOGUE
========================================================= */

.catalogue-tools{
    display:flex;
    gap:10px;
    flex-wrap:wrap;
    margin-bottom:30px;
}

.filter-btn{
    padding:9px 14px;
    border-radius:100px;
    background:rgba(255,255,255,.04);
    border:1px solid var(--border);
    color:#aaa;
}

.filter-btn.active,
.filter-btn:hover{
    color:white;
    background:rgba(139,92,246,.15);
    border-color:rgba(139,92,246,.35);
}

/* =========================================================
   UPCOMING
========================================================= */

.upcoming{
    background:
        radial-gradient(circle at 80% 50%,rgba(236,72,153,.08),transparent 30%),
        linear-gradient(180deg,transparent,rgba(255,255,255,.015),transparent);
}

.upcoming-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:20px;
}

.upcoming-card{
    min-height:280px;
    padding:30px;
    border-radius:24px;
    border:1px solid var(--border);
    background:linear-gradient(130deg,rgba(255,255,255,.055),rgba(255,255,255,.015));
    position:relative;
    overflow:hidden;
}

.upcoming-card::before{
    content:"";
    position:absolute;
    width:250px;
    height:250px;
    border-radius:50%;
    background:rgba(139,92,246,.14);
    filter:blur(50px);
    right:-100px;
    top:-100px;
}

.upcoming-card h3{
    font-size:27px;
    margin:12px 0;
}

.countdown{
    display:flex;
    gap:10px;
    margin-top:24px;
}

.time{
    padding:12px;
    min-width:55px;
    text-align:center;
    border-radius:10px;
    background:rgba(0,0,0,.3);
}

.time strong{
    display:block;
    font-size:18px;
}

.time span{
    font-size:8px;
    color:var(--muted);
}

/* =========================================================
   CHARACTERS
========================================================= */

.characters-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:18px;
}

.character{
    height:390px;
    border-radius:20px;
    overflow:hidden;
    position:relative;
    background-size:cover;
    background-position:center;
    border:1px solid var(--border);
    transition:.4s;
}

.character:hover{
    transform:translateY(-7px) scale(1.015);
}

.character::after{
    content:"";
    position:absolute;
    inset:0;
    background:linear-gradient(transparent 35%,rgba(0,0,0,.95));
}

.character-info{
    position:absolute;
    z-index:2;
    bottom:18px;
    left:18px;
}

.character-info small{
    color:#bca0ff;
    font-size:10px;
}

.character-info h3{
    font-size:21px;
    margin-top:4px;
}

.character-rank{
    position:absolute;
    z-index:3;
    top:14px;
    right:14px;
    width:35px;
    height:35px;
    border-radius:50%;
    display:grid;
    place-items:center;
    background:rgba(0,0,0,.65);
    backdrop-filter:blur(10px);
}

/* =========================================================
   RANKINGS
========================================================= */

.rankings{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:20px;
}

.rank-panel{
    padding:25px;
    background:var(--panel);
    border:1px solid var(--border);
    border-radius:22px;
}

.rank-row{
    display:flex;
    align-items:center;
    gap:14px;
    padding:14px 0;
    border-bottom:1px solid rgba(255,255,255,.06);
}

.rank-row:last-child{
    border-bottom:none;
}

.rank-number{
    width:25px;
    color:#888;
    font-size:12px;
}

.avatar{
    width:38px;
    height:38px;
    border-radius:50%;
    background:linear-gradient(135deg,#7551ca,#dd5d9e);
    display:grid;
    place-items:center;
    font-size:12px;
}

.rank-name{
    flex:1;
}

.rank-name strong{
    display:block;
    font-size:13px;
}

.rank-name span{
    color:var(--muted);
    font-size:10px;
}

.rank-value{
    color:var(--gold);
    font-size:11px;
}

/* =========================================================
   SUPPORT
========================================================= */

.support{
    text-align:center;
    padding:100px 6%;
}

.crystal-orb{
    width:100px;
    height:100px;
    margin:0 auto 25px;
    border-radius:50%;
    background:
        radial-gradient(circle at 35% 30%,#fff,#b58aff 18%,#6b36bd 55%,#271344);
    box-shadow:
        0 0 35px rgba(160,100,255,.6),
        0 0 100px rgba(160,100,255,.2);
    animation:crystalFloat 3s ease-in-out infinite;
}

@keyframes crystalFloat{
    50%{
        transform:translateY(-12px) rotate(8deg);
    }
}

.support h2{
    font-size:42px;
    margin-bottom:15px;
}

.support>p{
    color:var(--muted);
    max-width:600px;
    margin:auto;
    line-height:1.7;
}

.grades{
    max-width:800px;
    margin:35px auto 0;
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:10px;
}

.grade{
    padding:18px;
    border-radius:14px;
    background:var(--panel);
    border:1px solid var(--border);
}

.grade span{
    display:block;
    font-size:10px;
    color:var(--muted);
}

.grade strong{
    display:block;
    margin-top:5px;
    color:var(--gold);
}

/* =========================================================
   LIBRARY
========================================================= */

.library-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:18px;
}

.library-card{
    padding:28px;
    min-height:180px;
    border-radius:20px;
    border:1px solid var(--border);
    background:var(--panel);
    transition:.3s;
}

.library-card:hover{
    transform:translateY(-5px);
    background:var(--panel2);
}

.library-icon{
    font-size:30px;
    margin-bottom:18px;
}

.library-card h3{
    margin-bottom:8px;
}

.library-card p{
    color:var(--muted);
    font-size:12px;
    line-height:1.7;
}

/* =========================================================
   MODAL
========================================================= */

.modal{
    position:fixed;
    inset:0;
    z-index:2000;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:20px;
    background:rgba(0,0,0,.78);
    backdrop-filter:blur(15px);
    opacity:0;
    visibility:hidden;
    transition:.3s;
}

.modal.active{
    opacity:1;
    visibility:visible;
}

.modal-box{
    width:min(900px,100%);
    max-height:90vh;
    overflow-y:auto;
    border-radius:25px;
    background:#111018;
    border:1px solid var(--border);
    transform:translateY(25px) scale(.97);
    transition:.35s;
}

.modal.active .modal-box{
    transform:translateY(0) scale(1);
}

.modal-top{
    min-height:340px;
    padding:35px;
    display:flex;
    align-items:end;
    position:relative;
    background-size:cover;
    background-position:center;
}

.modal-top::after{
    content:"";
    position:absolute;
    inset:0;
    background:linear-gradient(transparent 20%,#111018);
}

.modal-title{
    position:relative;
    z-index:2;
}

.modal-title h2{
    font-size:40px;
}

.modal-content{
    padding:30px 35px 40px;
}

.modal-content p{
    color:#aaa7b4;
    line-height:1.8;
    font-size:13px;
}

.modal-meta{
    display:flex;
    gap:10px;
    flex-wrap:wrap;
    margin:20px 0;
}

.tag{
    padding:7px 11px;
    border-radius:100px;
    background:rgba(139,92,246,.1);
    border:1px solid rgba(139,92,246,.2);
    color:#c2a6ff;
    font-size:10px;
}

.platforms{
    margin-top:25px;
}

.platforms h4{
    margin-bottom:12px;
}

.platform{
    display:inline-block;
    margin:4px;
    padding:10px 14px;
    border-radius:10px;
    background:rgba(255,255,255,.05);
    border:1px solid var(--border);
    color:white;
    text-decoration:none;
    font-size:11px;
}

.close{
    position:absolute;
    z-index:5;
    top:18px;
    right:18px;
    width:38px;
    height:38px;
    border-radius:50%;
    border:1px solid rgba(255,255,255,.15);
    background:rgba(0,0,0,.5);
    color:white;
    font-size:20px;
}

/* =========================================================
   AUTH
========================================================= */

.auth-box{
    width:min(430px,100%);
    padding:32px;
    border-radius:24px;
    background:#111018;
    border:1px solid var(--border);
    position:relative;
}

.auth-box h2{
    font-size:28px;
    margin-bottom:8px;
}

.auth-subtitle{
    color:var(--muted);
    font-size:12px;
    line-height:1.6;
    margin-bottom:25px;
}

.field{
    margin-bottom:14px;
}

.field label{
    display:block;
    color:#aaa;
    font-size:11px;
    margin-bottom:7px;
}

.field input,
.field textarea,
.field select{
    width:100%;
    padding:13px;
    border-radius:11px;
    border:1px solid var(--border);
    outline:none;
    background:rgba(255,255,255,.05);
    color:white;
}

.field textarea{
    min-height:120px;
    resize:vertical;
}

.field select option{
    background:#111018;
}

.auth-actions{
    display:flex;
    gap:10px;
    margin-top:20px;
}

.auth-actions .btn{
    flex:1;
}

.auth-switch{
    text-align:center;
    color:var(--muted);
    font-size:11px;
    margin-top:18px;
}

.auth-switch button{
    background:none;
    border:0;
    color:#b996ff;
}

.search-box{
    width:min(700px,100%);
    padding:28px;
    border-radius:24px;
    background:#111018;
    border:1px solid var(--border);
}

.search-input{
    width:100%;
    padding:17px 18px;
    border-radius:13px;
    border:1px solid var(--border);
    background:rgba(255,255,255,.05);
    color:white;
    outline:none;
    font-size:15px;
}

.search-results{
    margin-top:20px;
    display:grid;
    gap:8px;
    max-height:55vh;
    overflow-y:auto;
}

.search-result{
    width:100%;
    text-align:left;
    padding:14px;
    border-radius:12px;
    border:1px solid var(--border);
    background:rgba(255,255,255,.035);
    color:white;
}

.search-result:hover{
    background:rgba(139,92,246,.12);
}

.search-result small{
    display:block;
    color:#a78bfa;
    margin-bottom:5px;
    font-size:9px;
    letter-spacing:1px;
}

/* =========================================================
   ADMIN
========================================================= */

.admin-page{
    min-height:100vh;
    padding:110px 5% 70px;
}

.admin-header{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:20px;
    margin-bottom:30px;
}

.admin-header h1{
    font-size:36px;
}

.admin-header p{
    color:var(--muted);
    font-size:12px;
    margin-top:5px;
}

.admin-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:15px;
    margin-bottom:30px;
}

.admin-stat{
    padding:22px;
    border:1px solid var(--border);
    border-radius:18px;
    background:var(--panel);
}

.admin-stat span{
    color:var(--muted);
    font-size:10px;
    text-transform:uppercase;
    letter-spacing:1px;
}

.admin-stat strong{
    display:block;
    font-size:30px;
    margin-top:7px;
}

.admin-panel{
    background:var(--panel);
    border:1px solid var(--border);
    border-radius:20px;
    padding:25px;
    margin-bottom:20px;
}

.admin-panel h2{
    font-size:20px;
    margin-bottom:18px;
}

.admin-form-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:14px;
}

.admin-form-grid .full{
    grid-column:1/-1;
}

.check-row{
    display:flex;
    gap:18px;
    flex-wrap:wrap;
    align-items:center;
}

.check-row label{
    display:flex;
    align-items:center;
    gap:7px;
    color:#bbb;
    font-size:12px;
}

.admin-actions{
    display:flex;
    gap:8px;
    flex-wrap:wrap;
    margin-top:15px;
}

.admin-book-list{
    display:grid;
    gap:10px;
}

.admin-book{
    padding:16px;
    border:1px solid var(--border);
    border-radius:13px;
    background:rgba(255,255,255,.025);
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:15px;
}

.admin-book-info strong{
    display:block;
    font-size:13px;
}

.admin-book-info span{
    color:var(--muted);
    font-size:10px;
}

.admin-message{
    margin-bottom:20px;
    padding:13px 15px;
    border-radius:11px;
    background:rgba(139,92,246,.1);
    border:1px solid rgba(139,92,246,.2);
    color:#cbb8ff;
    font-size:11px;
}

/* =========================================================
   TOAST
========================================================= */

#toast{
    position:fixed;
    z-index:10000;
    bottom:25px;
    left:50%;
    transform:translate(-50%,20px);
    background:#15131d;
    border:1px solid var(--border);
    color:white;
    padding:13px 18px;
    border-radius:12px;
    font-size:12px;
    opacity:0;
    pointer-events:none;
    transition:.3s;
    box-shadow:0 15px 50px rgba(0,0,0,.4);
}

#toast.show{
    opacity:1;
    transform:translate(-50%,0);
}

/* =========================================================
   FOOTER
========================================================= */

footer{
    padding:50px 6%;
    border-top:1px solid var(--border);
    display:flex;
    justify-content:space-between;
    color:#66636f;
    font-size:11px;
}

footer strong{
    color:#aaa;
}

/* =========================================================
   READER SUPPORT + COUNTDOWN + UPLOADS
========================================================= */

.public-countdown{
    display:none;
    margin-top:22px;
    padding:18px;
    border:1px solid rgba(139,92,246,.22);
    border-radius:16px;
    background:rgba(139,92,246,.07);
}
.public-countdown.active{display:block}
.public-countdown h4{font-size:15px;margin-bottom:6px}
.public-countdown p{font-size:11px;color:var(--muted);margin:0 0 12px}
.public-countdown .countdown{margin-top:0}
.public-countdown .time{min-width:58px}
.countdown-finished{color:#86efac;font-size:12px;font-weight:700}

.support-box{
    margin-top:25px;
    padding:20px;
    border:1px solid rgba(244,201,93,.16);
    border-radius:16px;
    background:rgba(244,201,93,.045);
}
.support-box h4{margin-bottom:8px}
.support-balance{color:var(--gold);font-size:12px;margin-bottom:12px}
.support-actions{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.support-actions input{
    width:120px;padding:11px;border-radius:10px;border:1px solid var(--border);
    background:rgba(255,255,255,.05);color:#fff;outline:none;
}
.support-rules{
    margin-top:18px;padding:16px;border-radius:14px;
    background:rgba(255,255,255,.03);border:1px solid var(--border);
}
.support-rules strong{display:block;margin-bottom:6px}
.support-rules p{font-size:11px!important;line-height:1.7!important;color:var(--muted)!important}

.upload-field{
    display:flex;gap:8px;align-items:center;flex-wrap:wrap;
}
.upload-field input[type="text"]{flex:1;min-width:180px}
.upload-field input[type="file"]{
    width:100%;padding:10px;border-radius:10px;border:1px solid var(--border);
    background:rgba(255,255,255,.035);color:#aaa;font-size:11px;
}
.upload-status{font-size:10px;color:var(--muted);margin-top:6px}

.profile-summary{
    display:grid;grid-template-columns:90px 1fr;gap:18px;align-items:center;margin-bottom:22px;
}
.profile-avatar{
    width:82px;height:82px;border-radius:50%;object-fit:cover;
    background:linear-gradient(135deg,#7551ca,#dd5d9e);display:grid;place-items:center;font-weight:700;font-size:24px;
}
.profile-balance{
    padding:18px;border-radius:16px;border:1px solid rgba(244,201,93,.16);
    background:rgba(244,201,93,.045);margin-bottom:18px;
}
.profile-balance strong{display:block;font-size:28px;color:var(--gold);margin-top:4px}

@media(max-width:600px){
    .profile-summary{grid-template-columns:1fr;text-align:center}
    .profile-avatar{margin:auto}
}

/* =========================================================
   MOBILE
========================================================= */


/* =========================================================
   READER SETTINGS
========================================================= */

.settings-wrap{
    max-width:1050px;
    margin:0 auto;
}

.settings-hero{
    padding:28px;
    border:1px solid var(--border);
    border-radius:26px;
    background:
        radial-gradient(circle at 90% 10%,rgba(139,92,246,.18),transparent 32%),
        linear-gradient(135deg,rgba(255,255,255,.06),rgba(255,255,255,.02));
    box-shadow:0 30px 80px rgba(0,0,0,.25);
    margin-bottom:20px;
}

.settings-profile-row{
    display:flex;
    align-items:center;
    gap:22px;
}

.settings-avatar-wrap{position:relative;flex:0 0 auto}
.settings-avatar{
    width:100px;
    height:100px;
    border-radius:50%;
    object-fit:cover;
    display:block;
    border:2px solid rgba(255,255,255,.16);
    background:linear-gradient(135deg,#7551ca,#dd5d9e);
    box-shadow:0 15px 45px rgba(0,0,0,.35);
}

.settings-avatar-fallback{
    display:grid;
    place-items:center;
    color:#fff;
    font-size:28px;
    font-weight:700;
}

.avatar-upload-btn{
    position:absolute;
    right:-4px;
    bottom:-4px;
    width:34px;
    height:34px;
    border-radius:50%;
    border:1px solid rgba(255,255,255,.18);
    background:var(--purple);
    color:white;
    box-shadow:0 8px 25px rgba(0,0,0,.4);
}

.settings-profile-copy h1{font-size:32px;margin-bottom:7px}
.settings-profile-copy p{color:var(--muted);font-size:12px;line-height:1.7}
.settings-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:18px;
}

.settings-card{
    padding:24px;
    border:1px solid var(--border);
    border-radius:22px;
    background:var(--panel);
}
.settings-card.full{grid-column:1/-1}
.settings-card h2{font-size:18px;margin-bottom:5px}
.settings-card>p{font-size:11px;color:var(--muted);margin-bottom:20px;line-height:1.6}

.settings-form-grid{display:grid;grid-template-columns:1fr 1fr;gap:15px}
.settings-field{display:flex;flex-direction:column;gap:7px}
.settings-field.full{grid-column:1/-1}
.settings-field label{font-size:10px;color:#aaa;text-transform:uppercase;letter-spacing:1px}
.settings-field input,.settings-field textarea,.settings-field select{
    width:100%;
    padding:12px 13px;
    border-radius:11px;
    border:1px solid var(--border);
    background:rgba(0,0,0,.22);
    color:white;
    outline:none;
}
.settings-field textarea{min-height:110px;resize:vertical;line-height:1.6}
.settings-field input:focus,.settings-field textarea:focus,.settings-field select:focus{border-color:var(--purple);box-shadow:0 0 0 3px rgba(139,92,246,.1)}

.colour-control{display:flex;gap:10px;align-items:center}
.colour-control input[type=color]{width:52px;height:42px;padding:3px;border-radius:10px;border:1px solid var(--border);background:transparent}
.colour-control input[type=text]{flex:1}

.theme-options{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.theme-option{
    padding:14px;
    border:1px solid var(--border);
    border-radius:14px;
    background:rgba(255,255,255,.03);
    color:#bbb;
    text-align:left;
}
.theme-option.active{border-color:var(--purple);background:rgba(139,92,246,.12);color:white;box-shadow:0 0 0 1px rgba(139,92,246,.2) inset}
.theme-option strong{display:block;font-size:12px;margin-bottom:5px}
.theme-option span{font-size:9px;color:var(--muted)}

.avatar-status{font-size:10px;color:var(--muted);margin-top:10px;min-height:15px}
.settings-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}
.settings-logout{margin-top:20px;border-top:1px solid var(--border);padding-top:20px}

@media(max-width:700px){
    .settings-grid,.settings-form-grid{grid-template-columns:1fr}
    .settings-card.full{grid-column:auto}
    .settings-profile-row{align-items:flex-start;flex-direction:column}
    .theme-options{grid-template-columns:1fr}
}

/* =========================================================
   ADMIN V2
========================================================= */

.admin-shell{
    display:grid;
    grid-template-columns:220px 1fr;
    gap:22px;
}

.admin-sidebar{
    position:sticky;
    top:100px;
    height:max-content;
    padding:14px;
    border:1px solid var(--border);
    border-radius:20px;
    background:rgba(255,255,255,.035);
}

.admin-tab{
    width:100%;
    text-align:left;
    padding:12px 14px;
    margin-bottom:6px;
    border:1px solid transparent;
    border-radius:11px;
    background:transparent;
    color:#aaa;
    font-size:12px;
}
.admin-tab:hover,.admin-tab.active{
    color:#fff;
    background:rgba(139,92,246,.12);
    border-color:rgba(139,92,246,.22);
}

.admin-content{min-width:0}
.admin-section{display:none}
.admin-section.active{display:block}

.admin-section-head{
    display:flex;
    justify-content:space-between;
    align-items:flex-start;
    gap:15px;
    margin-bottom:20px;
}
.admin-section-head h2{font-size:24px}
.admin-section-head p{color:var(--muted);font-size:11px;margin-top:5px}

.admin-badge{
    display:inline-flex;
    align-items:center;
    gap:6px;
    padding:7px 10px;
    border-radius:100px;
    background:rgba(74,222,128,.08);
    border:1px solid rgba(74,222,128,.18);
    color:#86efac;
    font-size:10px;
}

.admin-card-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:14px;
}

.admin-mini-card{
    padding:18px;
    border:1px solid var(--border);
    border-radius:16px;
    background:var(--panel);
}
.admin-mini-card span{display:block;color:var(--muted);font-size:10px;text-transform:uppercase;letter-spacing:1px}
.admin-mini-card strong{display:block;font-size:25px;margin-top:8px}

.admin-table{
    width:100%;
    border-collapse:collapse;
}
.admin-table th,.admin-table td{
    padding:12px 10px;
    border-bottom:1px solid rgba(255,255,255,.06);
    text-align:left;
    font-size:11px;
}
.admin-table th{color:#888;text-transform:uppercase;font-size:9px;letter-spacing:1px}
.admin-table td{color:#ddd}

.admin-toggle{
    display:flex;
    align-items:center;
    gap:8px;
    font-size:11px;
    color:#bbb;
    margin:8px 0;
}

.admin-divider{
    height:1px;
    background:var(--border);
    margin:22px 0;
}

.setting-note{
    padding:12px 14px;
    border-radius:11px;
    background:rgba(139,92,246,.07);
    border:1px solid rgba(139,92,246,.15);
    color:#bca7e9;
    font-size:11px;
    line-height:1.6;
    margin-bottom:18px;
}

.admin-book-preview{
    display:flex;
    align-items:center;
    gap:12px;
}
.admin-book-preview img{
    width:45px;
    height:58px;
    border-radius:7px;
    object-fit:cover;
}
.admin-book-preview div{min-width:0}
.admin-book-preview strong{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.admin-book-preview span{display:block;color:var(--muted);font-size:10px;margin-top:4px}

@media(max-width:900px){
    .admin-shell{grid-template-columns:1fr}
    .admin-sidebar{
        position:relative;
        top:auto;
        display:flex;
        overflow-x:auto;
        gap:6px;
    }
    .admin-tab{width:auto;white-space:nowrap;margin:0}
    .admin-card-grid{grid-template-columns:repeat(2,1fr)}
}

@media(max-width:1000px){

    .hero{
        grid-template-columns:1fr;
        padding-top:100px;
    }

    .feature-book{
        width:min(500px,100%);
    }

    .books-grid{
        grid-template-columns:repeat(2,1fr);
    }

    .characters-grid{
        grid-template-columns:repeat(2,1fr);
    }

    .admin-grid{
        grid-template-columns:repeat(2,1fr);
    }
}

@media(max-width:700px){

    .nav{
        padding:12px 4%;
    }

    .nav-links{
        position:absolute;
        top:68px;
        left:0;
        width:100%;
        padding:10px 4%;
        background:rgba(7,7,11,.96);
        border-bottom:1px solid var(--border);
        overflow-x:auto;
    }

    .nav-link{
        white-space:nowrap;
        font-size:11px;
    }

    .nav-actions .icon-btn{
        width:36px;
        height:36px;
    }

    .profile-btn{
        padding:0 12px;
    }

    .hero{
        padding:95px 5% 60px;
        min-height:auto;
    }

    .hero h1{
        font-size:48px;
    }

    .page-section,
    .support{
        padding:60px 5%;
    }

    .books-grid,
    .characters-grid,
    .upcoming-grid,
    .rankings,
    .library-grid{
        grid-template-columns:1fr;
    }

    .grades{
        grid-template-columns:repeat(2,1fr);
    }

    .feature-book{
        height:420px;
    }

    .modal-title h2{
        font-size:30px;
    }

    .admin-form-grid{
        grid-template-columns:1fr;
    }

    .admin-form-grid .full{
        grid-column:auto;
    }

    .admin-grid{
        grid-template-columns:1fr 1fr;
    }

    .admin-header{
        align-items:flex-start;
        flex-direction:column;
    }

    footer{
        flex-direction:column;
        gap:10px;
    }
}

.book-card-actions{display:flex;gap:8px;margin-top:12px;flex-wrap:wrap}.book-card-actions .btn{font-size:10px;padding:9px 11px}.notification-bell{position:relative}.notification-badge{position:absolute;top:-3px;right:-3px;min-width:16px;height:16px;border-radius:50%;background:#ec4899;color:white;font-size:9px;place-items:center;border:2px solid #07070b}.notification-list{display:grid;gap:8px;max-height:60vh;overflow:auto}.notification-item{display:grid;text-align:left;gap:4px;padding:13px;border:1px solid var(--border);border-radius:12px;background:rgba(255,255,255,.035);color:white}.notification-item.unread{border-color:rgba(139,92,246,.35);background:rgba(139,92,246,.08)}.notification-item span,.notification-item small{color:var(--muted);font-size:10px}.modal-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:18px}


/* =========================================================
   STORY READER
========================================================= */

.reader-modal{position:fixed;inset:0;z-index:1200;background:rgba(0,0,0,.92);display:none;overflow:hidden}
.reader-modal.active{display:block}
.reader-shell{height:100%;display:flex;flex-direction:column;background:var(--bg,#0b0b10)}
.reader-header{min-height:72px;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:14px 20px;border-bottom:1px solid var(--border,#292933);background:rgba(12,12,18,.98);flex-shrink:0}
.reader-header-info{min-width:0}
.reader-book-title{font-size:12px;color:var(--muted,#999);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.reader-chapter-title{font-size:20px;font-weight:700;margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.reader-header-actions{display:flex;gap:8px;flex-shrink:0}
.reader-icon-btn{width:42px;height:42px;border:1px solid var(--border,#292933);border-radius:10px;background:transparent;color:inherit;font-size:18px;cursor:pointer}
.reader-progress{height:3px;width:0;background:var(--violet,#8b5cf6);flex-shrink:0;transition:width .1s linear}
.reader-content-wrap{flex:1;overflow-y:auto;scroll-behavior:smooth}
.reader-content{width:min(760px,calc(100% - 36px));margin:0 auto;padding:48px 0 80px;font-size:18px;line-height:1.8;transition:font-size .15s,line-height .15s}
.reader-content p{margin:0 0 1.35em;white-space:pre-wrap;overflow-wrap:anywhere}
.reader-loading,.reader-empty{text-align:center;color:var(--muted,#999);padding:60px 20px}
.reader-footer{min-height:68px;display:flex;align-items:center;justify-content:center;gap:10px;padding:10px 16px;border-top:1px solid var(--border,#292933);background:rgba(12,12,18,.98);flex-shrink:0}
.reader-nav-btn{border:1px solid var(--border,#292933);background:transparent;color:inherit;border-radius:10px;padding:11px 15px;cursor:pointer;font-weight:600}
.reader-nav-btn.primary{background:var(--violet,#8b5cf6);border-color:var(--violet,#8b5cf6);color:#fff}
.reader-nav-btn:disabled{opacity:.35;cursor:not-allowed}
.reader-settings{display:none;position:absolute;right:18px;top:78px;width:min(330px,calc(100% - 36px));padding:18px;border:1px solid var(--border,#292933);border-radius:14px;background:#111119;box-shadow:0 20px 60px rgba(0,0,0,.45);z-index:3}
.reader-settings.active{display:block}
.reader-setting{margin-top:16px}
.reader-setting label{display:block;font-size:12px;color:var(--muted,#999);margin-bottom:7px}
.reader-setting input,.reader-setting select{width:100%;box-sizing:border-box}
.reader-setting select{padding:9px;border:1px solid var(--border,#292933);border-radius:8px;background:#181820;color:inherit}
.reader-chapter-list{display:flex;flex-direction:column;gap:8px;max-height:60vh;overflow-y:auto;margin-top:18px}
.reader-chapter-item{width:100%;text-align:left;padding:13px;border:1px solid var(--border,#292933);border-radius:10px;background:transparent;color:inherit;cursor:pointer}
.reader-chapter-item.active{border-color:var(--violet,#8b5cf6);background:rgba(139,92,246,.12)}
.reader-chapter-item strong{display:block}
.reader-chapter-item span{display:block;color:var(--muted,#999);font-size:12px;margin-top:3px}
@media(max-width:600px){
  .reader-header{padding:12px 14px}
  .reader-chapter-title{font-size:16px}
  .reader-content{width:min(100% - 28px,760px);padding-top:32px;font-size:17px}
  .reader-footer{gap:6px}
  .reader-nav-btn{padding:10px 11px;font-size:12px}
}

</style>
</head>

<body>

<!-- =====================================================
     INTRO
===================================================== -->

<div id="intro">

    <div class="intro-stars"></div>

    <div class="intro-title">
        <div class="small">ENTER THE</div>
        <h1>BGDADDY</h1>
        <p>Story Universe</p>
    </div>

    <div class="dragon">

        <div class="dragon-body"></div>

        <div class="dragon-head">
            <div class="dragon-eye"></div>
            <div class="dragon-horn horn1"></div>
            <div class="dragon-horn horn2"></div>
            <div class="dragon-whisker"></div>
        </div>

        <div class="wing wing1"></div>
        <div class="wing wing2"></div>
        <div class="dragon-tail"></div>

    </div>

    <button class="intro-skip" onclick="skipIntro()">
        Skip intro
    </button>

</div>


<!-- =====================================================
     APP
===================================================== -->

<div id="app">

    <nav class="nav">

        <div class="logo">
            BG<span>DADDY</span>
        </div>

        <div class="nav-links">

            <button class="nav-link active" data-page="home" onclick="navigate('home')">
                Home
            </button>

            <button class="nav-link" data-page="books" onclick="navigate('books')">
                Books
            </button>

            <button class="nav-link" data-page="characters" onclick="navigate('characters')">
                Characters
            </button>

            <button class="nav-link" data-page="rankings" onclick="navigate('rankings')">
                Rankings
            </button>

            <button class="nav-link" data-page="support" onclick="navigate('support')">
                Support
            </button>

            <button class="nav-link" data-page="library" onclick="navigate('library')">
                Library
            </button>

        </div>

        <div class="nav-actions">

            <button class="icon-btn" aria-label="Search" onclick="openSearch()">
                ⌕
            </button>

            <button class="icon-btn notification-bell" aria-label="Notifications" onclick="openNotifications()">
                🔔<span id="notificationBadge" class="notification-badge" style="display:none;"></span>
            </button>

            <button class="nav-link" id="settingsNav" style="display:none;" onclick="navigate('settings')">
                ⚙️ Settings
            </button>

            <button class="nav-link" id="adminNav" style="display:none;" onclick="navigate('admin')">
                🛡️ Admin
            </button>

            <button class="profile-btn" id="profileButton" onclick="openAuth()">
                Sign In
            </button>

        </div>

    </nav>


    <!-- =================================================
         HOME
    ================================================= -->

    <section id="page-home" class="app-page active">

        <div class="hero">

            <div>

                <div class="eyebrow">
                    THE AUTHOR UNIVERSE
                </div>

                <h1>
                    Enter the worlds
                    <span>I've created.</span>
                </h1>

                <p>
                    Discover stories, characters, worlds and legends.
                    Follow your favourite books, support their journeys,
                    climb the reader rankings and explore the entire
                    universe.
                </p>

                <div class="hero-buttons">

                    <button class="btn primary" onclick="navigate('books')">
                        Explore Books
                    </button>

                    <button class="btn" onclick="navigate('characters')">
                        Meet the Characters
                    </button>

                </div>

            </div>

            <div class="feature-book" id="featureBook">

                <div class="feature-info">

                    <small>FEATURED STORY</small>

                    <h2 id="featureTitle">
                        Reincarnated as a Side Character
                    </h2>

                    <p id="featureSubtitle">
                        The Villainess is Obsessed with Me
                    </p>

                    <br>

                    <button class="btn primary" id="featureButton">
                        Explore Story
                    </button>

                </div>

            </div>

        </div>


        <section class="page-section">

            <div class="section-heading">

                <div>
                    <h2>🔥 Trending Stories</h2>
                    <p>Stories currently attracting the most attention.</p>
                </div>

                <button class="btn" onclick="navigate('books')">
                    View catalogue
                </button>

            </div>

            <div class="books-grid" id="homeBooksGrid"></div>

        </section>


        <section class="page-section upcoming">
            <div class="section-heading">
                <div>
                    <h2>🆕 Coming Soon</h2>
                    <p>Stories waiting beyond the horizon.</p>
                </div>
            </div>
            <div class="upcoming-grid" id="upcomingGrid"></div>
        </section>

    </section>


    <!-- =================================================
         BOOKS
    ================================================= -->

    <section id="page-books" class="app-page">

        <section class="page-section">

            <div class="section-heading">

                <div>

                    <div class="eyebrow">
                        STORY CATALOGUE
                    </div>

                    <h2>📚 All Books</h2>

                    <p>
                        Explore ongoing, upcoming and pre-release stories.
                    </p>

                </div>

            </div>

            <div class="catalogue-tools">

                <button class="filter-btn active" onclick="filterBooks('all',this)">
                    All
                </button>

                <button class="filter-btn" onclick="filterBooks('ongoing',this)">
                    Ongoing
                </button>

                <button class="filter-btn" onclick="filterBooks('pre-release',this)">
                    Pre-release
                </button>

                <button class="filter-btn" onclick="filterBooks('development',this)">
                    Development
                </button>

            </div>

            <div class="books-grid" id="catalogueGrid"></div>

        </section>

    </section>


    <!-- =================================================
         CHARACTERS
    ================================================= -->

    <section id="page-characters" class="app-page">

        <section class="page-section">

            <div class="section-heading">

                <div>

                    <div class="eyebrow">
                        CHARACTER UNIVERSE
                    </div>

                    <h2>👤 Characters</h2>

                    <p>
                        Heroes, villains and legends across the universe.
                    </p>

                </div>

            </div>

            <div class="characters-grid" id="charactersGrid"></div>

        </section>

    </section>


    <!-- =================================================
         RANKINGS
    ================================================= -->

    <section id="page-rankings" class="app-page">

        <section class="page-section">

            <div class="section-heading">

                <div>

                    <div class="eyebrow">
                        THE HALL OF FAME
                    </div>

                    <h2>🏆 Rankings</h2>

                    <p>
                        The readers and stories shaping the universe.
                    </p>

                </div>

            </div>

            <div class="rankings">

                <div class="rank-panel">

                    <h3>👑 Top Readers</h3>

                    <div class="rank-row">
                        <div class="rank-number">01</div>
                        <div class="avatar">S</div>
                        <div class="rank-name">
                            <strong>ShadowReader</strong>
                            <span>Grade 8</span>
                        </div>
                        <div class="rank-value">💎 12,840</div>
                    </div>

                    <div class="rank-row">
                        <div class="rank-number">02</div>
                        <div class="avatar">A</div>
                        <div class="rank-name">
                            <strong>Aether</strong>
                            <span>Grade 7</span>
                        </div>
                        <div class="rank-value">💎 10,421</div>
                    </div>

                    <div class="rank-row">
                        <div class="rank-number">03</div>
                        <div class="avatar">R</div>
                        <div class="rank-name">
                            <strong>Raven</strong>
                            <span>Grade 6</span>
                        </div>
                        <div class="rank-value">💎 9,882</div>
                    </div>

                    <div class="rank-row">
                        <div class="rank-number">04</div>
                        <div class="avatar">V</div>
                        <div class="rank-name">
                            <strong>VoidWalker</strong>
                            <span>Grade 5</span>
                        </div>
                        <div class="rank-value">💎 8,201</div>
                    </div>

                </div>


                <div class="rank-panel">

                    <h3>📚 Most Supported</h3>

                    <div id="supportedRankings"></div>

                </div>

            </div>

        </section>

    </section>


    <!-- =================================================
         SUPPORT
    ================================================= -->

    <section id="page-support" class="app-page">

        <section class="support">

            <div class="crystal-orb"></div>

            <div class="eyebrow">
                THE SUPPORT SYSTEM
            </div>

            <h2>💎 Support the Stories</h2>

            <p>
                Readers progress through grades as they explore
                the universe. Their journey unlocks increasingly
                powerful crystal support, including the special
                God-Level Support Path.
            </p>

            <div class="grades">

                <div class="grade"><span>GRADE 1</span><strong>💎 2</strong></div>
                <div class="grade"><span>GRADE 2</span><strong>💎 5</strong></div>
                <div class="grade"><span>GRADE 3</span><strong>💎 10</strong></div>
                <div class="grade"><span>GRADE 4</span><strong>💎 20</strong></div>
                <div class="grade"><span>GRADE 5</span><strong>💎 35</strong></div>
                <div class="grade"><span>ELITE</span><strong>💎 50</strong></div>
                <div class="grade"><span>ROYAL</span><strong>💎 100</strong></div>
                <div class="grade"><span>GOD LEVEL</span><strong>💎 500+</strong></div>

            </div>

        </section>

    </section>


    <!-- =================================================
         LIBRARY
    ================================================= -->

    <section id="page-library" class="app-page">

        <section class="page-section">

            <div class="section-heading">

                <div>

                    <div class="eyebrow">
                        YOUR READER SPACE
                    </div>

                    <h2>📖 My Library</h2>

                    <p>Your personal reading universe.</p>

                </div>

            </div>

            <div id="libraryLoggedOut" class="library-grid">

                <div class="library-card">
                    <div class="library-icon">📖</div>
                    <h3>Currently Reading</h3>
                    <p>Sign in to keep track of stories you're currently reading.</p>
                </div>

                <div class="library-card">
                    <div class="library-icon">🕘</div>
                    <h3>Previously Read</h3>
                    <p>Your reading history will be stored here.</p>
                </div>

                <div class="library-card">
                    <div class="library-icon">❤️</div>
                    <h3>Following</h3>
                    <p>Follow stories you don't want to miss.</p>
                </div>

                <div class="library-card">
                    <div class="library-icon">💎</div>
                    <h3>Supported</h3>
                    <p>See stories you've supported with crystals.</p>
                </div>

                <div class="library-card">
                    <div class="library-icon">⭐</div>
                    <h3>Reviews</h3>
                    <p>Your reviews and ratings will live here.</p>
                </div>

                <div class="library-card">
                    <div class="library-icon">🏅</div>
                    <h3>Achievements</h3>
                    <p>Unlock achievements as you explore the universe.</p>
                </div>

            </div>

            <div id="libraryLoggedIn" style="display:none;">

                <div class="library-grid">

                    <div class="library-card">
                        <div class="library-icon">📖</div>
                        <h3>Currently Reading</h3>
                        <p id="readingCount">Loading...</p>
                    </div>

                    <div class="library-card">
                        <div class="library-icon">❤️</div>
                        <h3>Following</h3>
                        <p id="followingCount">Loading...</p>
                    </div>

                    <div class="library-card">
                        <div class="library-icon">💎</div>
                        <h3>Crystals</h3>
                        <p id="userCrystals">Loading...</p>
                    </div>

                </div>
                <div class="admin-panel" style="margin-top:20px;">
                    <h2>My Stories</h2>
                    <div id="libraryBookList" class="admin-book-list"></div>
                </div>

            </div>

        </section>

    </section>


    <!-- =================================================
         READER SETTINGS
    ================================================= -->

    <section id="page-settings" class="app-page">
        <section class="page-section">
            <div class="settings-wrap">
                <div class="settings-hero">
                    <div class="settings-profile-row">
                        <div class="settings-avatar-wrap">
                            <img id="settingsAvatar" class="settings-avatar" alt="Profile avatar" style="display:none;">
                            <div id="settingsAvatarFallback" class="settings-avatar settings-avatar-fallback">?</div>
                            <input id="avatarFileInput" type="file" accept="image/png,image/jpeg,image/webp,image/gif" style="display:none;" onchange="handleAvatarUpload(event)">
                            <button class="avatar-upload-btn" type="button" onclick="document.getElementById('avatarFileInput').click()" aria-label="Upload avatar">＋</button>
                        </div>
                        <div class="settings-profile-copy">
                            <div class="eyebrow">YOUR READER SPACE</div>
                            <h1>Account Settings</h1>
                            <p>Shape your profile, choose your look, and upload your own avatar. Changes are saved to your BGDADDY reader account.</p>
                            <div id="avatarStatus" class="avatar-status"></div>
                        </div>
                    </div>
                </div>

                <div id="settingsMessage"></div>

                <div class="settings-grid">
                    <div class="settings-card">
                        <h2>Profile</h2>
                        <p>Update the information other readers see.</p>
                        <div class="settings-form-grid">
                            <div class="settings-field">
                                <label>Username</label>
                                <input id="settingsUsername" maxlength="40" placeholder="Your username">
                            </div>
                            <div class="settings-field">
                                <label>Display Name</label>
                                <input id="settingsDisplayName" maxlength="60" placeholder="Your display name">
                            </div>
                            <div class="settings-field full">
                                <label>Bio</label>
                                <textarea id="settingsBio" maxlength="300" placeholder="Tell readers a little about yourself..."></textarea>
                            </div>
                        </div>
                    </div>

                    <div class="settings-card">
                        <h2>Accent Colour</h2>
                        <p>Choose the colour used for your personal interface accents.</p>
                        <div class="colour-control">
                            <input id="settingsAccentColor" type="color" value="#8b5cf6" oninput="previewAccent(this.value)">
                            <input id="settingsAccentText" type="text" value="#8b5cf6" maxlength="7" oninput="syncAccentText(this.value)">
                        </div>
                        <div class="settings-actions">
                            <button class="btn" type="button" onclick="resetAccent()">Reset Accent</button>
                        </div>
                    </div>

                    <div class="settings-card full">
                        <h2>Theme</h2>
                        <p>Choose the atmosphere of your Story Universe. Your selection is saved to your profile.</p>
                        <div class="theme-options">
                            <button class="theme-option active" type="button" data-theme-option="default" onclick="selectTheme('default',this)">
                                <strong>Default</strong><span>Dark luxury with violet accents</span>
                            </button>
                            <button class="theme-option" type="button" data-theme-option="midnight" onclick="selectTheme('midnight',this)">
                                <strong>Midnight</strong><span>Deeper blacks and cooler tones</span>
                            </button>
                            <button class="theme-option" type="button" data-theme-option="rose" onclick="selectTheme('rose',this)">
                                <strong>Rose</strong><span>Dark luxury with a warmer finish</span>
                            </button>
                        </div>
                        <input id="settingsTheme" type="hidden" value="default">
                    </div>
                </div>

                <div class="settings-actions">
                    <button class="btn primary" type="button" onclick="saveProfileSettings()">Save Changes</button>
                    <button class="btn" type="button" onclick="loadProfileSettings()">Discard Changes</button>
                </div>

                <div class="settings-logout">
                    <button class="btn" type="button" onclick="signOut()">Sign Out</button>
                </div>
            </div>
        </section>
    </section>


    <!-- =================================================
         ADMIN PAGE
    ================================================= -->

    <section id="page-admin" class="app-page">

    <div class="admin-page">

        <div class="admin-header">
            <div>
                <div class="eyebrow">BGDADDY CONTROL CENTRE</div>
                <h1>Admin Dashboard</h1>
                <p>Manage books, releases, chapters and the public Story Universe.</p>
            </div>
            <div class="admin-actions" style="margin:0;">
                <span class="admin-badge"><span class="connection-dot online"></span> Administrator</span>
                <button class="btn" onclick="navigate('home')">← Public Site</button>
            </div>
        </div>

        <div id="adminMessage"></div>

        <div class="admin-shell">

            <aside class="admin-sidebar">
                <button class="admin-tab active" data-admin-tab="overview" onclick="switchAdminTab('overview',this)">📊 Overview</button>
                <button class="admin-tab" data-admin-tab="books" onclick="switchAdminTab('books',this)">📚 Books</button>
                <button class="admin-tab" data-admin-tab="releases" onclick="switchAdminTab('releases',this)">⏳ Pre-release</button>
                <button class="admin-tab" data-admin-tab="chapters" onclick="switchAdminTab('chapters',this)">📖 Chapters</button>
                <button class="admin-tab" data-admin-tab="characters" onclick="switchAdminTab('characters',this)">👤 Characters</button>
                <button class="admin-tab" data-admin-tab="site" onclick="switchAdminTab('site',this)">🌐 Public Site</button>
                <button class="admin-tab" data-admin-tab="system" onclick="switchAdminTab('system',this)">⚙️ System</button>
            </aside>

            <main class="admin-content">

                <section class="admin-section active" data-admin-section="overview">
                    <div class="admin-section-head">
                        <div><h2>Overview</h2><p>Your Story Universe at a glance.</p></div>
                        <button class="btn" onclick="loadAdminDashboard()">↻ Refresh</button>
                    </div>

                    <div class="admin-card-grid">
                        <div class="admin-mini-card"><span>Total Books</span><strong id="adminBookCount">0</strong></div>
                        <div class="admin-mini-card"><span>Published Books</span><strong id="adminPublishedCount">0</strong></div>
                        <div class="admin-mini-card"><span>Pre-release</span><strong id="adminPreReleaseCount">0</strong></div>
                        <div class="admin-mini-card"><span>Chapters</span><strong id="adminChapterCount">0</strong></div>
                        <div class="admin-mini-card"><span>Characters</span><strong id="adminCharacterCount">0</strong></div>
                        <div class="admin-mini-card"><span>Reviews</span><strong id="adminReviewCount">0</strong></div>
                    </div>

                    <div class="admin-panel" style="margin-top:20px;">
                        <h2>Quick Actions</h2>
                        <div class="admin-actions">
                            <button class="btn primary" onclick="switchAdminTab('books');resetBookForm()">＋ New Book</button>
                            <button class="btn" onclick="switchAdminTab('releases')">⏳ Manage Releases</button>
                            <button class="btn" onclick="switchAdminTab('chapters')">＋ Add Chapter</button>
                            <button class="btn" onclick="switchAdminTab('site')">⚙️ Site Settings</button>
                        </div>
                    </div>
                </section>

                <section class="admin-section" data-admin-section="books">
                    <div class="admin-section-head">
                        <div><h2>Book Manager</h2><p>Create and control every book in the universe.</p></div>
                        <button class="btn" onclick="resetBookForm()">＋ New Book</button>
                    </div>

                    <div class="admin-panel">
                        <h2 id="bookFormTitle">Add New Book</h2>
                        <input type="hidden" id="adminBookId">

                        <div class="admin-form-grid">
                            <div class="field"><label>Title</label><input id="adminTitle" placeholder="Book title"></div>
                            <div class="field"><label>Slug</label><input id="adminSlug" placeholder="book-slug"></div>

                            <div class="field">
                                <label>Status</label>
                                <select id="adminStatus">
                                    <option value="ongoing">Ongoing</option>
                                    <option value="completed">Completed</option>
                                    <option value="hiatus">Hiatus</option>
                                    <option value="development">Development</option>
                                    <option value="pre-release">Pre-release</option>
                                    <option value="coming-soon">Coming Soon</option>
                                </select>
                            </div>

                            <div class="field"><label>Author</label><input id="adminAuthor" value="BGDADDY"></div>
                            <div class="field full">
    <label>Book Cover</label>
    <div class="upload-field">
        <input id="adminCover" type="text" placeholder="Cover URL or upload a file">
        <input id="adminCoverFile" type="file" accept="image/*" onchange="uploadBookCover(this.files[0])">
    </div>
    <div class="upload-status" id="adminCoverStatus">Upload a cover directly to Supabase Storage, or keep using a URL.</div>
</div>
                            <div class="field full"><label>Description</label><textarea id="adminDescription" placeholder="Book description"></textarea></div>
                            <div class="field"><label>Default Crystals</label><input id="adminCrystals" type="number" value="0"></div>
                            <div class="field"><label>Default Votes</label><input id="adminVotes" type="number" value="0"></div>
                            <div class="field"><label>Default Readers</label><input id="adminReaders" type="number" value="0"></div>
                        </div>

                        <div class="check-row">
                            <label><input type="checkbox" id="adminFeatured"> Featured</label>
                            <label><input type="checkbox" id="adminTrending"> Trending</label>
                            <label><input type="checkbox" id="adminPublished"> Published</label>
                        </div>

                        <div class="admin-actions">
                            <button class="btn primary" onclick="saveBook()">Save Book</button>
                            <button class="btn" onclick="resetBookForm()">Clear</button>
                        </div>
                    </div>

                    <div class="admin-panel">
                        <h2>Your Books</h2>
                        <div id="adminBookList" class="admin-book-list">Loading books...</div>
                    </div>
                </section>

                <section class="admin-section" data-admin-section="releases">
                    <div class="admin-section-head">
                        <div><h2>Pre-release & Countdown</h2><p>Control exactly how an upcoming book appears to readers.</p></div>
                    </div>

                    <div class="setting-note">
                        Select a book, configure its release date and countdown, then save. These settings are stored in Supabase and will later drive the public countdown automatically.
                    </div>

                    <div class="admin-panel">
                        <div class="admin-form-grid">
                            <div class="field full"><label>Book</label><select id="releaseBook" onchange="loadReleaseSettings(this.value)"></select></div>
                            <div class="field"><label>Release Date & Time</label><input id="releaseDate" type="datetime-local"></div>
                            <div class="field"><label>Release Chapter Count</label><input id="releaseChapterCount" type="number" min="0" value="0"></div>
                            <div class="field full"><label>Countdown Title</label><input id="releaseTitle" placeholder="The story begins in..."></div>
                            <div class="field full"><label>Countdown Message</label><textarea id="releaseMessage" placeholder="Prepare yourself for the next story..."></textarea></div>
                            <div class="field full"><label>Pre-release Description</label><textarea id="releaseDescription" placeholder="Description shown during pre-release."></textarea></div>
                        </div>

                        <div class="check-row">
                            <label><input type="checkbox" id="releaseEnabled"> Enable Countdown</label>
                            <label><input type="checkbox" id="releaseHome"> Show on Homepage</label>
